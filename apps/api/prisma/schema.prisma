generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Safe schema comment to force PR webhook build trigger
}

model User {
  id                        String                        @id
  email                     String                        @unique
  passwordHash              String
  emailVerified             Boolean
  failedLoginCount          Int
  lockUntil                 DateTime?
  accessStatus              UserAccessStatus              @default(ACTIVE)
  accessVersion             Int                           @default(0)
  displayName               String?
  recoveryEmail             String?
  primaryEmailAddressPolicy AuthPrimaryEmailAddressPolicy @default(ACCOUNT_EMAIL)
  backupEmailPolicy         AuthBackupEmailPolicy         @default(RECOVERY_EMAIL)
  role                      AuthUserRole                  @default(CUSTOMER)
  mfaRequired               Boolean                       @default(false)
  mfaEncryptedSecret        String?
  mfaEnrolledAt             DateTime?
  mfaVerifiedAt             DateTime?
  mfaFailedCount            Int                           @default(0)
  mfaLockedUntil            DateTime?
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt
  assessmentOwners          Assessment[]                  @relation("AssessmentOwner")
  auditExportRequests       AuditExportRequest[]          @relation("AuditExportRequester")
  authRecords               AuthRecord[]
  gitHubAppInstallStates    GitHubAppInstallState[]       @relation("GitHubAppInstallStateUser")
  repositoryConnections     RepositoryConnection[]        @relation("RepositoryConnectionUser")
  repositorySnapshots       RepositorySnapshot[]          @relation("RepositorySnapshotActor")
  billingWallet             BillingWallet?
  billingOrders             BillingOrder[]
  creditLedgerEntries       CreditLedgerEntry[]
  billingReservations       BillingReservation[]
  llmUsageEvents            LlmUsageEvent[]
  paymentTransactions       PaymentTransaction[]

  @@index([accessStatus, role, createdAt, id])
}

model AuthRecord {
  id         String         @id
  userId     String?
  type       AuthRecordType
  lookupKey  String         @unique
  secretHash String?
  expiresAt  DateTime?
  usedAt     DateTime?
  revokedAt  DateTime?
  metadata   Json?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([type, expiresAt])
  @@index([userId, type, revokedAt, usedAt])
}

enum AuthRecordType {
  SESSION
  MFA_OTP_USE
  MFA_RECOVERY_CODE
  RECOVERY_REQUEST
  OAUTH_IDENTITY
  OAUTH_STATE
}

enum AuthBackupEmailPolicy {
  ALL_VERIFIED
  RECOVERY_EMAIL
}

enum AuthPrimaryEmailAddressPolicy {
  ACCOUNT_EMAIL
  RECOVERY_EMAIL
}

model AuditEvent {
  id            String             @id
  eventType     String
  actorId       String?
  resourceType  AuditResourceType?
  resourceId    String?
  decision      AuthDecision?
  reasonCode    String?
  correlationId String
  sessionId     String?
  payload       Json
  createdAt     DateTime           @default(now())

  @@index([correlationId])
  @@index([actorId, createdAt])
  @@index([eventType, createdAt])
  @@index([resourceId, eventType, createdAt])
}

model OutboxMessage {
  id              String              @id
  aggregateType   OutboxAggregateType
  aggregateId     String
  eventType       String
  payload         Json
  status          OutboxStatus        @default(PENDING)
  attempts        Int                 @default(0)
  lastAttemptAt   DateTime?
  nextAttemptAt   DateTime?
  publishedAt     DateTime?
  errorMessage    String?
  createdAt       DateTime            @default(now())
  assessmentEvent AssessmentEvent?

  // Composite event FK binds delivery to the same assessment aggregate.
  @@unique([id, aggregateId])
  @@index([status, nextAttemptAt, createdAt])
  @@index([aggregateType, aggregateId])
}

model Assessment {
  id                     String                    @id
  ownerId                String
  name                   String
  description            String?
  // Canonical lifecycle; initialization and transitions belong to the lifecycle coordinator.
  lifecycleState         AssessmentLifecycleState?
  lifecycleRevision      Int?
  blockerReason          BlockerReason?
  blockerReference       Json?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  gitHubAppInstallStates GitHubAppInstallState[]
  owner                  User                      @relation("AssessmentOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  repositoryConnections  RepositoryConnection[]
  repositoryScanJobs     RepositoryScanJob[]
  repositorySnapshots    RepositorySnapshot[]
  runtimeEvents          AssessmentRuntimeEvent[]
  runtimeTurns           AssessmentRuntimeTurn[]
  billingReservations    BillingReservation[]
  llmUsageEvents         LlmUsageEvent[]
  runtime                AssessmentRuntime?
  events                 AssessmentEvent[]
  domainCase             AssessmentCase?

  @@index([ownerId])
}

enum AgentStreamBoundaryType {
  ASSESSMENT
  RULE_SET_PREPARATION
}

enum AssessmentLifecycleState {
  CREATED
  PREPARING
  ACTIVE
  WAITING_FOR_HUMAN
  WAITING_FOR_REQUIRED_INPUT
  PAUSED
  FINALIZING
  COMPLETE
  BLOCKED
  FAILED
  CANCELLED
}

enum BlockerReason {
  HUMAN_FACT_UNRESOLVABLE
  REQUIRED_DOCUMENT_UNAVAILABLE
  REQUIRED_RUNTIME_INPUT_UNAVAILABLE
  COMPLIANCE_RULE_SET_UNAVAILABLE
  REPOSITORY_SNAPSHOT_UNAVAILABLE
}

enum ArtifactLifecycleState {
  BUILDING
  ACTIVE
  SUPERSEDED
  INVALID
}

enum LegalRequirementCoverageState {
  COVERED_BY_ASSESSMENT_RULES
  NON_ASSESSABLE
}

enum LegalContextRelationKind {
  DEFINITION
  SCOPE
  QUALIFIER
  EXCEPTION
  CROSS_REFERENCE
}

enum RuleSetPreparationFailureReason {
  MODEL_ERROR
  NO_SUBMISSION
  RULE_SET_VALIDATION_FAILED
  SOURCE_VERSION_UNAVAILABLE
  RUNTIME_ERROR
}

enum ComplianceRuleSetValidationOutcome {
  PASSED
  FAILED
}

enum AgentExecutionState {
  QUEUED
  RUNNING
  INTERRUPTED
  PAUSED
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AssessmentEventType {
  ACTIVITY_RECORDED
  ASSESSMENT_LIFECYCLE_CHANGED
  EXECUTION_STATE_CHANGED
  EVIDENCE_ACCEPTED
  DECISION_ACCEPTED
  HUMAN_RESOLUTION_CHANGED
  ARTIFACT_CHANGED
}

enum AssessmentEventActorType {
  RUNTIME
  ASSESSMENT_ROOT
  SUBAGENT
  TOOL
  API
}

/// Server-owned lifetime Root mapping; resume/retry updates execution, never identity.
model AssessmentRuntime {
  assessmentId        String                   @id
  threadId            String                   @unique @db.Uuid
  rootAgentVersion    String
  checkpointNamespace String
  checkpointId        String?
  currentExecutionId  String?                  @db.Uuid
  executionState      AgentExecutionState      @default(QUEUED)
  leaseToken          String?                  @db.Uuid
  leaseExpiresAt      DateTime?                @db.Timestamptz(3)
  // Increment with UPDATE ... RETURNING in the domain/event/outbox transaction.
  eventSequence       Int                      @default(0)
  startedAt           DateTime?                @db.Timestamptz(3)
  lastResumedAt       DateTime?                @db.Timestamptz(3)
  createdAt           DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @db.Timestamptz(3)
  assessment          Assessment               @relation(fields: [assessmentId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  events              AssessmentEvent[]
  humanRequests       AssessmentHumanRequest[]

  // Required by the event FK: a valid thread from another assessment is invalid.
  @@unique([assessmentId, threadId])
}

/// Canonical redacted envelope. API validates typed payload/usage before persistence.
model AssessmentEvent {
  eventId             String                   @id @db.Uuid
  assessmentId        String
  threadId            String                   @db.Uuid
  sequence            Int
  timestamp           DateTime                 @default(now()) @db.Timestamptz(3)
  eventType           AssessmentEventType
  actorType           AssessmentEventActorType
  executionId         String?                  @db.Uuid
  parentExecutionId   String?                  @db.Uuid
  taskId              String?
  toolCallId          String?
  payload             Json
  tokenUsage          Json?
  technicalDetailsRef String?                  @db.Uuid
  outboxMessageId     String                   @unique
  assessment          Assessment               @relation(fields: [assessmentId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  runtime             AssessmentRuntime        @relation(fields: [assessmentId, threadId], references: [assessmentId, threadId], onDelete: Cascade, onUpdate: Restrict)
  outboxMessage       OutboxMessage            @relation(fields: [outboxMessageId, assessmentId], references: [id, aggregateId], onDelete: Restrict, onUpdate: Restrict)

  // Ordered history/SSE cursor and publisher predecessor lookup; eventId is replay identity.
  @@unique([assessmentId, sequence])
  @@unique([outboxMessageId, assessmentId])
}

model AuditExportRequest {
  id             String            @id
  requestedById  String
  fromDate       DateTime
  toDate         DateTime
  status         AuditExportStatus @default(READY)
  version        Int               @default(1)
  checksumSha256 String
  contentJson    Json?
  correlationId  String
  createdAt      DateTime          @default(now())
  completedAt    DateTime?
  requestedBy    User              @relation("AuditExportRequester", fields: [requestedById], references: [id], onDelete: Restrict)
}

enum AuthDecision {
  ALLOW
  DENY
}

enum AuthUserRole {
  ADMIN
  CUSTOMER
}

enum AuditResourceType {
  AUTH_ACCOUNT
  ASSESSMENT
  ASSESSMENT_RECORD
  AUDIT_EXPORT_REQUEST
  AUTH_INVITATION
  AUTH_MFA_RECOVERY_CODE
  AUTH_SESSION
  GITHUB_APP_INSTALL_STATE
  HTTP_ROUTE
  LEGAL_REQUIREMENT
  COMPLIANCE_RULE_SET_VERSION
  LEGAL_SOURCE_VERSION
  OUTBOX
  REPOSITORY_CONNECTION
  REPOSITORY_SCAN_JOB
  REPOSITORY_SNAPSHOT
  WORKER_TASK
  WORKSPACE
}

enum OutboxAggregateType {
  BILLING_PAYMENT
  ASSESSMENT
  AUTH_USER
  LEGAL_SOURCE_VERSION
  COMPLIANCE_RULE_SET_VERSION
  REPOSITORY_SCAN_JOB
  REPOSITORY_SNAPSHOT
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
  DLQ
  CANCELLED
}

enum AuditExportStatus {
  QUEUED
  GENERATING
  READY
  FAILED
}

model RepositoryConnection {
  id                            String                         @id
  assessmentId                  String?
  userId                        String
  provider                      CredentialProvider             @default(GITHUB)
  installationId                String?
  authenticationMode            RepositoryAuthenticationMode   @default(GITHUB_APP)
  providerCredentialId          String?
  credentialVersion             Int?
  credentialAuthorizedByUserId  String?
  credentialAuthorizationStatus CredentialAuthorizationStatus?
  credentialValidatedAt         DateTime?
  credentialRevokedAt           DateTime?
  repositoryId                  String
  repositoryName                String
  repositoryFullName            String
  defaultBranch                 String
  permissions                   Json
  status                        RepositoryConnectionStatus     @default(ACTIVE)
  connectedAt                   DateTime                       @default(now())
  revokedAt                     DateTime?
  assessment                    Assessment?                    @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  providerCredential            ProviderCredential?            @relation(fields: [providerCredentialId], references: [id], onDelete: Restrict)
  snapshots                     RepositorySnapshot[]
  user                          User                           @relation("RepositoryConnectionUser", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([installationId, repositoryId])
  @@index([assessmentId])
  @@index([userId, provider, status])
  @@index([providerCredentialId])
}

model ProviderCredential {
  id                          String                   @id
  provider                    CredentialProvider
  ownerUserId                 String
  providerAccountId           BigInt
  providerLogin               String
  status                      ProviderCredentialStatus
  currentVersion              Int
  isActive                    Boolean                  @default(true)
  declaredExpiresAt           DateTime?
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  validatedAt                 DateTime?
  lastUsedAt                  DateTime?
  invalidatedAt               DateTime?
  revocationRequestedAt       DateTime?
  revokedAt                   DateTime?
  lastFailureCode             String?
  envelopeVersion             Int?
  encryptionAlgorithm         String?
  ciphertext                  Bytes?
  credentialNonce             Bytes?
  credentialAuthenticationTag Bytes?
  wrappedDekCiphertext        Bytes?
  wrappingNonce               Bytes?
  wrappingAuthenticationTag   Bytes?
  kekVersion                  String?
  repositoryConnections       RepositoryConnection[]

  @@index([ownerUserId, provider, isActive])
  @@index([ownerUserId, provider, providerAccountId])
}

model RepositorySnapshot {
  id                 String                   @id
  assessmentId       String
  connectionId       String
  repositoryId       String
  repositoryFullName String
  branch             String?
  ref                String?
  commitSha          String
  providerMetadata   Json
  actorId            String
  status             RepositorySnapshotStatus @default(READY)
  createdAt          DateTime                 @default(now())
  actor              User                     @relation("RepositorySnapshotActor", fields: [actorId], references: [id], onDelete: Restrict)
  assessment         Assessment               @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  connection         RepositoryConnection     @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  scanJobs           RepositoryScanJob[]

  @@index([assessmentId])
  @@index([connectionId])
  @@index([commitSha])
}

model RepositoryScanJob {
  id             String                      @id
  assessmentId   String
  snapshotId     String
  idempotencyKey String                      @unique
  triggerSource  RepositoryScanTriggerSource
  status         RepositoryScanJobStatus     @default(QUEUED)
  attemptCount   Int                         @default(0)
  correlationId  String
  blockedReason  String?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  assessment     Assessment                  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  snapshot       RepositorySnapshot          @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@index([snapshotId])
}

/// Accepted per-AssessmentRule assessment: the RuleEvidenceIndex ledger (accepted evidence only).

enum AssessmentRuntimeControlState {
  RUNNING
  STOP_REQUESTED
  STOPPED
  RESUME_REQUESTED
  COMPLETED
}

model AssessmentRuntimeTurn {
  id             String                        @id
  assessmentId   String
  threadId       String
  boundary       String
  logicalRunId   String
  workflowRunId  String?
  correlationId  String
  state          AssessmentRuntimeControlState @default(RUNNING)
  requestId      String?
  contextJson    Json
  checkpointJson Json?
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt
  assessment     Assessment                    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId, createdAt])
}

model AssessmentRuntimeEvent {
  id                String                  @id @default(uuid())
  assessmentId      String?
  boundaryType      AgentStreamBoundaryType @default(ASSESSMENT)
  boundaryId        String
  preparationRunId  String?
  runId             String
  correlationId     String
  sequence          Int
  toolName          String?
  summary           String
  inputSummaryJson  Json?
  outputSummaryJson Json?
  errorSummary      String?
  startedAt         DateTime?
  completedAt       DateTime?
  durationMs        Int?
  attempt           Int?
  waitingReason     String?
  createdAt         DateTime                @default(now())
  assessment        Assessment?             @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  preparationRun    RuleSetPreparationRun?  @relation(fields: [preparationRunId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([assessmentId, createdAt])
  @@index([boundaryType, boundaryId, createdAt])
  @@index([preparationRunId, createdAt])
  @@index([runId, sequence])
}

model GitHubAppInstallState {
  id           String      @id
  state        String      @unique
  assessmentId String?
  userId       String
  redirectUri  String
  expiresAt    DateTime
  createdAt    DateTime    @default(now())
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  user         User        @relation("GitHubAppInstallStateUser", fields: [userId], references: [id], onDelete: Restrict)
}

/// Admin-managed parent of an ordered family of immutable Legal Source Versions.
model LegalSource {
  id          String               @id @default(uuid())
  slug        String               @unique
  name        String
  description String?
  createdBy   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  versions    LegalSourceVersion[]
}

model LegalSourceVersion {
  id                     String                        @id @default(uuid())
  /// Always set: a database trigger assigns a parent when an insert names none (older callers).
  legalSourceId          String?
  version                String                        @unique
  status                 LegalSourceLifecycleStatus    @default(DRAFT)
  sourceManifest         Json
  integrityManifestRef   String?
  basedOnVersionId       String?
  createdBy              String?
  createdAt              DateTime                      @default(now())
  activatedAt            DateTime?
  legalSource            LegalSource?                  @relation(fields: [legalSourceId], references: [id], onDelete: Restrict)
  documents              LegalSourceDocument[]
  chunks                 LegalDocumentChunk[]
  activations            LegalSourceActivationRecord[]
  retrievalIndexes       LegalRetrievalIndex[]
  ruleSetPreparationRuns RuleSetPreparationRun[]
  ruleSetVersions        ComplianceRuleSetVersion[]

  @@index([status, createdAt])
  @@index([legalSourceId, createdAt])
}

model LegalRetrievalIndex {
  id                    String                    @id @default(uuid())
  legalSourceVersionId  String
  version               String                    @unique
  status                LegalRetrievalIndexStatus @default(BUILDING)
  configHash            String
  contentHash           String
  validationManifestRef String?
  validatedAt           DateTime?
  createdAt             DateTime                  @default(now())
  legalSourceVersion    LegalSourceVersion        @relation(fields: [legalSourceVersionId], references: [id], onDelete: Cascade)

  @@index([legalSourceVersionId, status, validatedAt])
}

model LegalSourceDocument {
  id                   String                            @id @default(uuid())
  legalSourceVersionId String
  documentId           String
  title                String
  sourceUrl            String
  sourceSha256         String
  effectiveDate        DateTime?
  sourceEffectStatus   String
  snapshotPath         String?
  origin               LegalSourceDocumentOrigin         @default(MIGRATED)
  ingestionState       LegalSourceDocumentIngestionState @default(READY)
  ingestionFailureCode String?
  ingestionAttempt     Int                               @default(0)
  mediaType            String?
  originalFileName     String?
  byteLength           Int?
  blobSha256           String?
  structureProfile     String?
  provenance           Json?
  extraction           Json?
  createdBy            String?
  createdAt            DateTime                          @default(now())
  ingestedAt           DateTime?
  legalSourceVersion   LegalSourceVersion                @relation(fields: [legalSourceVersionId], references: [id], onDelete: Cascade)
  blob                 LegalSourceDocumentBlob?          @relation(fields: [blobSha256], references: [sha256], onDelete: Restrict)
  chunks               LegalDocumentChunk[]

  @@unique([legalSourceVersionId, documentId])
  @@index([documentId])
  @@index([blobSha256])
}

/// Content-addressed original bytes of an uploaded or imported document. Immutable: a changed
/// file is a different hash, so a version never rewrites what another version pinned.
model LegalSourceDocumentBlob {
  sha256     String                @id
  byteLength Int
  bytes      Bytes
  createdAt  DateTime              @default(now())
  documents  LegalSourceDocument[]
}

model LegalSourceSnapshot {
  id                  String   @id @default(uuid())
  snapshotRef         String   @unique
  snapshotId          String   @unique
  catalogSourceRef    String
  adminCatalogVersion String
  documentId          String
  documentNumber      String?
  sourceUrl           String
  finalUrl            String?
  contentType         String
  byteLength          Int
  contentSha256       String
  snapshotObjectKey   String
  provenanceRef       String
  retrievedAt         DateTime
  sourceEffectStatus  String?
  normalizationSource String?
  identityVerified    Boolean  @default(false)
  correlationId       String
  createdAt           DateTime @default(now())

  @@index([catalogSourceRef, createdAt])
  @@index([documentId, createdAt])
  @@index([contentSha256])
}

model LegalDocumentChunk {
  id                      String                            @id
  legalSourceVersionId    String
  legalSourceDocumentId   String
  documentId              String
  locator                 String
  content                 String
  contentSha256           String
  hierarchy               Json
  legalStatus             String
  legalEffectStatus       LegalEffectStatus                 @default(UNKNOWN)
  legalStatusSourceRef    String?
  pageStart               Int?
  pageEnd                 Int?
  createdAt               DateTime                          @default(now())
  legalSourceVersion      LegalSourceVersion                @relation(fields: [legalSourceVersionId], references: [id], onDelete: Cascade)
  sourceDocument          LegalSourceDocument               @relation(fields: [legalSourceDocumentId], references: [id], onDelete: Cascade)
  ruleSetProvenance       LegalRequirementProvenance[]
  ruleSetContextRelations LegalRequirementContextRelation[]

  @@unique([id, legalSourceVersionId])
  @@unique([legalSourceVersionId, documentId, locator])
  @@index([legalSourceVersionId, documentId])
  @@index([legalSourceVersionId, legalStatus])
}

model LegalSourceActivationRecord {
  id                     String                     @id @default(uuid())
  legalSourceVersionId   String
  activatedBy            String
  status                 LegalSourceLifecycleStatus
  idempotencyKey         String?
  integrityManifestRef   String?
  retrievalValidationRef String?
  outboxEventId          String?
  scopeDescription       String
  comments               String?
  activatedAt            DateTime                   @default(now())
  legalSourceVersion     LegalSourceVersion         @relation(fields: [legalSourceVersionId], references: [id], onDelete: Cascade)

  @@unique([idempotencyKey])
  @@index([legalSourceVersionId])
}

