model SePayWebhookEvent {
  id                    String    @id @default(uuid())
  provider              String
  providerTransactionId String
  sanitizedPayload      Json?
  integrityHash         String?
  securityAcceptedAt    DateTime?
  receivedAt            DateTime  @default(now())
  processedAt           DateTime?
  createdAt             DateTime  @default(now())

  paymentTransaction PaymentTransaction?

  @@unique([provider, providerTransactionId])
  @@index([receivedAt])
}

model PaymentTransaction {
  id                    String                       @id @default(uuid())
  provider              String
  providerTransactionId String
  amountMinorUnits      BigInt
  reconciliationStatus  PaymentReconciliationStatus  @default(UNMATCHED)
  reconciliationReason  PaymentReconciliationReason?
  reconciliationVersion Int                          @default(0)
  userId                String?
  billingOrderId        String?
  webhookEventId        String?                      @unique
  receivedAt            DateTime                     @default(now())
  reconciledAt          DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  user                  User?                        @relation(fields: [userId], references: [id], onDelete: Restrict)
  billingOrder          BillingOrder?                @relation(fields: [billingOrderId], references: [id], onDelete: Restrict)
  webhookEvent          SePayWebhookEvent?           @relation(fields: [webhookEventId], references: [id], onDelete: Restrict)

  @@unique([provider, providerTransactionId])
  @@index([userId, createdAt])
  @@index([reconciliationStatus, createdAt])
  @@index([reconciliationStatus, reconciledAt])
  @@index([provider, receivedAt])
  @@index([receivedAt, id])
}

model CreditLedgerEntry {
  id             String        @id @default(uuid())
  userId         String
  walletId       String
  billingOrderId String?
  idempotencyKey String        @unique
  source         String
  referenceId    String?
  deltaCredits   BigInt
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  wallet         BillingWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  billingOrder   BillingOrder? @relation(fields: [billingOrderId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([walletId, createdAt])
  @@index([source, referenceId])
  @@index([source, createdAt])
}

model BillingReservation {
  id                   String                              @id @default(uuid())
  userId               String
  walletId             String
  workspaceId          String?
  assessmentId         String?
  scanJobId            String?
  threadId             String?
  runId                String?
  provider             String?
  model                String?
  invocationId         String?
  modelInvocationId    String?
  amountCredits        BigInt
  initialAmountCredits BigInt?
  remainingCredits     BigInt                              @default(0)
  maxInvocations       BigInt                              @default(1)
  invocationsStarted   BigInt                              @default(0)
  status               BillingReservationStatus            @default(RESERVED)
  idempotencyKey       String?
  settledAt            DateTime?
  releasedAt           DateTime?
  createdAt            DateTime                            @default(now())
  updatedAt            DateTime                            @updatedAt
  user                 User                                @relation(fields: [userId], references: [id], onDelete: Restrict)
  wallet               BillingWallet                       @relation(fields: [walletId], references: [id], onDelete: Restrict)
  assessment           Assessment?                         @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  usageEvents          LlmUsageEvent[]
  invocationClaims     BillingReservationInvocationClaim[]

  @@unique([userId, idempotencyKey])
  @@index([assessmentId, runId])
  @@index([scanJobId])
  @@index([threadId])
  @@index([invocationId])
  @@index([modelInvocationId])
  @@index([userId, status, createdAt])
  @@index([walletId, status])
}

model BillingReservationInvocationClaim {
  id                       String             @id @default(uuid())
  reservationId            String
  invocationId             String
  authorizedChargeCredits  BigInt             @default(0)
  authorizationFingerprint String?
  settledAt                DateTime?
  createdAt                DateTime           @default(now())
  reservation              BillingReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@unique([reservationId, invocationId])
  @@index([invocationId])
  @@index([reservationId, settledAt])
}

model ModelPricingSnapshot {
  id                         String          @id @default(uuid())
  provider                   String
  model                      String
  inputPricePerMillion       Decimal         @db.Decimal(20, 8)
  cachedInputPricePerMillion Decimal?        @db.Decimal(20, 8)
  cacheWritePricePerMillion  Decimal?        @db.Decimal(20, 8)
  outputPricePerMillion      Decimal         @db.Decimal(20, 8)
  reasoningPricePerMillion   Decimal?        @db.Decimal(20, 8)
  // Immutable composite authority for provider cost, customer markup, and FX.
  // Legacy snapshots may omit composite fields; settlement rejects them.
  providerCurrency           String?
  customerCurrency           String?
  markupBps                  BigInt?
  fxRateVndNumerator         BigInt?
  fxRateVndDenominator       BigInt?
  version                    Int
  effectiveAt                DateTime
  createdAt                  DateTime        @default(now())
  usageEvents                LlmUsageEvent[]

  @@unique([provider, model, version])
  @@index([provider, model, effectiveAt])
}

model RuntimeModelPolicySnapshot {
  id            String          @id @default(uuid())
  role          String
  provider      String
  model         String
  policyVersion String
  effectiveAt   DateTime
  createdAt     DateTime        @default(now())
  usageEvents   LlmUsageEvent[]

  @@unique([role, policyVersion])
  @@index([role, effectiveAt])
}

model LlmUsageEvent {
  id                      String                      @id @default(uuid())
  userId                  String
  assessmentId            String?
  runId                   String?
  agentRole               String                      @default("LEGACY")
  provider                String
  model                   String
  invocationId            String
  status                  LlmUsageStatus              @default(SETTLED)
  availabilityReason      String?
  providerResponseId      String?
  inputTokens             BigInt?
  cachedInputTokens       BigInt?
  cacheWriteTokens        BigInt?
  outputTokens            BigInt?
  reasoningTokens         BigInt?
  totalTokens             BigInt?
  pricingSnapshotId       String?
  runtimePolicySnapshotId String?
  providerCostCredits     BigInt?
  customerChargeVnd       BigInt?
  reservationId           String?
  chargedCredits          BigInt?
  occurredAt              DateTime                    @default(now())
  createdAt               DateTime                    @default(now())
  user                    User                        @relation(fields: [userId], references: [id], onDelete: Restrict)
  assessment              Assessment?                 @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  pricingSnapshot         ModelPricingSnapshot?       @relation(fields: [pricingSnapshotId], references: [id], onDelete: Restrict)
  runtimePolicySnapshot   RuntimeModelPolicySnapshot? @relation(fields: [runtimePolicySnapshotId], references: [id], onDelete: Restrict)
  reservation             BillingReservation?         @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@unique([userId, invocationId])
  @@unique([provider, providerResponseId])
  @@index([assessmentId, runId, createdAt])
  @@index([reservationId, createdAt])
  @@index([userId, createdAt])
  @@index([provider, model, createdAt])
}

// ---------------------------------------------------------------------------
// Compliance rule set (expand-only). One Rule Set Preparation run authors one
// complete LegalRequirement + AssessmentRule set against one pinned immutable
// legal source version. The activation transaction is the only writer of the ACTIVE pointer.
// V1 LegalSourceVersion / LegalRequirement / approval rows are untouched. Physical table and column
// names match the canonical physical PostgreSQL schema.
// ---------------------------------------------------------------------------

model RuleSetPreparationRun {
  id                   String                             @id @default(uuid())
  idempotencyKey       String                             @unique
  legalSourceVersionId String
  requestedBy          String
  correlationId        String
  executionState       AgentExecutionState                @default(QUEUED)
  failureReason        RuleSetPreparationFailureReason?
  outboxEventId        String?
  createdAt            DateTime                           @default(now())
  startedAt            DateTime?
  completedAt          DateTime?
  legalSourceVersion   LegalSourceVersion                 @relation(fields: [legalSourceVersionId], references: [id], onDelete: Restrict)
  ruleSet              ComplianceRuleSetVersion?
  activationRecord     ComplianceRuleSetActivationRecord?
  runtimeEvents        AssessmentRuntimeEvent[]

  @@index([legalSourceVersionId])
  @@index([executionState, createdAt])
}

model ComplianceRuleSetVersion {
  id                      String                              @id @default(uuid())
  version                 String                              @unique
  legalSourceVersionId    String
  preparationRunId        String                              @unique
  lifecycleState          ArtifactLifecycleState              @default(BUILDING)
  ruleSetDigest           String
  validationOutcome       ComplianceRuleSetValidationOutcome?
  validationFailures      Json                                @default("[]")
  createdAt               DateTime                            @default(now())
  validatedAt             DateTime?
  activatedAt             DateTime?
  supersededAt            DateTime?
  legalSourceVersion      LegalSourceVersion                  @relation(fields: [legalSourceVersionId], references: [id], onDelete: Restrict)
  preparationRun          RuleSetPreparationRun               @relation(fields: [preparationRunId], references: [id], onDelete: Restrict)
  rules                   LegalRequirement[]
  assessmentRules         AssessmentRule[]
  provenance              LegalRequirementProvenance[]
  contextRelations        LegalRequirementContextRelation[]
  activation              ComplianceRuleSetActivationRecord?  @relation("ActivationTarget")
  supersededByActivations ComplianceRuleSetActivationRecord[] @relation("ActivationPrevious")
  assessmentCases         AssessmentCase[]

  // Lets child rows prove they share the rule set's legal source version (composite FK).
  @@unique([id, legalSourceVersionId])
  @@index([lifecycleState])
  @@index([legalSourceVersionId])
}

model LegalRequirement {
  id                      String                            @id @default(uuid())
  ruleSetVersionId        String
  legalRequirementId      String
  title                   String
  proposition             String
  applicabilityConditions Json
  qualifiers              Json
  exceptions              Json
  nonRepositoryDuty       Boolean
  coverageState           LegalRequirementCoverageState
  nonAssessableReason     String?
  contentDigest           String
  ordinal                 Int
  ruleSet                 ComplianceRuleSetVersion          @relation(fields: [ruleSetVersionId], references: [id], onDelete: Restrict)
  assessmentRuleLinks     AssessmentRuleLegalRequirement[]
  provenance              LegalRequirementProvenance[]
  outgoingRelations       LegalRequirementContextRelation[] @relation("RelationFrom")

  @@unique([ruleSetVersionId, legalRequirementId])
  @@unique([id, ruleSetVersionId])
}

model AssessmentRule {
  id                    String                           @id @default(uuid())
  ruleSetVersionId      String
  assessmentRuleId      String
  assessmentRuleVersion String
  concept               String
  legalIntent           String
  applicabilityGuidance String
  criteria              Json
  contract              Json
  sourceFingerprint     String
  contentDigest         String
  ordinal               Int
  createdAt             DateTime                         @default(now())
  ruleSet               ComplianceRuleSetVersion         @relation(fields: [ruleSetVersionId], references: [id], onDelete: Restrict)
  legalRequirementLinks AssessmentRuleLegalRequirement[]
  assessmentDecisions   AssessmentRuleDecision[]
  assessmentCoverage    AssessmentDecisionCoverage[]

  @@unique([ruleSetVersionId, assessmentRuleId])
  @@unique([id, ruleSetVersionId])
}

// same-rule-set ownership is enforced by the composite foreign keys.
model AssessmentRuleLegalRequirement {
  ruleSetVersionId      String
  assessmentRuleRowId   String
  legalRequirementRowId String
  assessmentRule        AssessmentRule   @relation(fields: [assessmentRuleRowId, ruleSetVersionId], references: [id, ruleSetVersionId], onDelete: Restrict)
  legalRequirement      LegalRequirement @relation(fields: [legalRequirementRowId, ruleSetVersionId], references: [id, ruleSetVersionId], onDelete: Restrict)

  @@id([assessmentRuleRowId, legalRequirementRowId])
  @@index([legalRequirementRowId])
}

// Server-resolved proof: the chunk must belong to the rule set's own legal source version.
model LegalRequirementProvenance {
  id                    String                   @id @default(uuid())
  ruleSetVersionId      String
  legalRequirementRowId String
  legalSourceVersionId  String
  chunkId               String
  documentId            String
  locator               String
  contentSha256         String
  sourceEffectStatus    String
  legalEffectStatus     LegalEffectStatus        @default(UNKNOWN)
  legalStatusSourceRef  String?
  ordinal               Int
  ruleSet               ComplianceRuleSetVersion @relation(fields: [ruleSetVersionId, legalSourceVersionId], references: [id, legalSourceVersionId], onDelete: Restrict)
  rule                  LegalRequirement         @relation(fields: [legalRequirementRowId, ruleSetVersionId], references: [id, ruleSetVersionId], onDelete: Restrict)
  chunk                 LegalDocumentChunk       @relation(fields: [chunkId, legalSourceVersionId], references: [id, legalSourceVersionId], onDelete: Restrict)

  @@unique([legalRequirementRowId, chunkId])
  @@index([ruleSetVersionId])
}

// Exactly one of toRuleId / toChunkId (CHECK in the migration). toRuleId also
// carries a raw composite FK (toRuleId, ruleSetVersionId) in the migration.
model LegalRequirementContextRelation {
  id                   String                   @id @default(uuid())
  ruleSetVersionId     String
  relationId           String
  kind                 LegalContextRelationKind
  fromRuleId           String
  toRuleId             String?
  toChunkId            String?
  legalSourceVersionId String
  relationDigest       String
  ordinal              Int
  ruleSet              ComplianceRuleSetVersion @relation(fields: [ruleSetVersionId, legalSourceVersionId], references: [id, legalSourceVersionId], onDelete: Restrict)
  fromRule             LegalRequirement         @relation("RelationFrom", fields: [fromRuleId, ruleSetVersionId], references: [id, ruleSetVersionId], onDelete: Restrict)
  toChunk              LegalDocumentChunk?      @relation(fields: [toChunkId, legalSourceVersionId], references: [id, legalSourceVersionId], onDelete: Restrict)

  @@unique([ruleSetVersionId, relationId])
  @@index([fromRuleId])
}

// Mechanical activation audit. Not an approval: no human approver, no
// approve/reject lifecycle. Failure records the INVALID candidate's result.
model ComplianceRuleSetActivationRecord {
  id                             String                             @id @default(uuid())
  ruleSetVersionId               String                             @unique
  preparationRunId               String                             @unique
  idempotencyKey                 String                             @unique
  requestDigest                  String
  validationOutcome              ComplianceRuleSetValidationOutcome
  validationFailures             Json                               @default("[]")
  previousActiveRuleSetVersionId String?
  outboxEventId                  String?
  correlationId                  String
  createdAt                      DateTime                           @default(now())
  ruleSet                        ComplianceRuleSetVersion           @relation("ActivationTarget", fields: [ruleSetVersionId], references: [id], onDelete: Restrict)
  previousActive                 ComplianceRuleSetVersion?          @relation("ActivationPrevious", fields: [previousActiveRuleSetVersionId], references: [id], onDelete: Restrict)
  preparationRun                 RuleSetPreparationRun              @relation(fields: [preparationRunId], references: [id], onDelete: Restrict)

  @@index([previousActiveRuleSetVersionId])
}

// ---------------------------------------------------------------------------------------------
// Assessment domain. Authoritative, revisioned, provenance-validated state of one assessment's
// Root run. Rows are written only by the API assessment-domain boundary; nothing here is a legal
// judgment by deterministic code. Raw-SQL guards in the migration enforce pins, immutability and
// the decision-resolution transition table.
// ---------------------------------------------------------------------------------------------

enum AssessmentEvidenceType {
  REPOSITORY_SOURCE
  SEARCH_COVERAGE
  HUMAN_ANSWER
}

enum AssessmentRecordState {
  ACCEPTED
  INVALIDATED
}

enum AssessmentFactKind {
  FACT
  USE_CASE
}

enum AssessmentFactAuthority {
  EVIDENCE_CITED
  HUMAN_PROVIDED
}

enum AssessmentDecisionRecordState {
  ACCEPTED
  SUPERSEDED
  INVALIDATED
}

enum DecisionResolutionState {
  PENDING
  INVESTIGATING
  WAITING_FOR_INPUT
  RESOLVED
  INVALIDATED
}

enum HumanResolutionRequestStatus {
  OPEN
  RESOLVED
  SUPERSEDED
  CANCELLED
}

enum RuleDecisionApplicability {
  APPLICABLE
  NOT_APPLICABLE
}

enum RuleDecisionComplianceOutcome {
  COMPLIANT
  NON_COMPLIANT
}

enum AssessmentArtifactKind {
  FINAL_REPORT
}

/// One per assessment. Pins are set once and never rewritten (DB trigger): a superseding legal
/// basis or a new repository requires a new assessment.
model AssessmentCase {
  assessmentId         String                       @id
  caseRevision         Int                          @default(0)
  ruleSetVersionId     String?
  repositorySnapshotId String?
  repositoryScanJobId  String?
  repositoryCommit     String?
  pinnedAt             DateTime?                    @db.Timestamptz(3)
  createdAt            DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                     @updatedAt @db.Timestamptz(3)
  assessment           Assessment                   @relation(fields: [assessmentId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  ruleSet              ComplianceRuleSetVersion?    @relation(fields: [ruleSetVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  facts                AssessmentCaseFact[]
  evidence             AssessmentEvidence[]
  decisions            AssessmentRuleDecision[]
  coverage             AssessmentDecisionCoverage[]
  humanRequests        AssessmentHumanRequest[]
  artifacts            AssessmentArtifact[]

  // Lets children prove they use the case's own pinned rule set (composite FK).
  @@unique([assessmentId, ruleSetVersionId])
}

model AssessmentEvidence {
  evidenceId       String                       @id @db.Uuid
  assessmentId     String
  type             AssessmentEvidenceType
  state            AssessmentRecordState        @default(ACCEPTED)
  repositoryCommit String
  contentSha256    String
  payload          Json
  createdAt        DateTime                     @default(now()) @db.Timestamptz(3)
  invalidatedAt    DateTime?                    @db.Timestamptz(3)
  assessmentCase   AssessmentCase               @relation(fields: [assessmentId], references: [assessmentId], onDelete: Cascade, onUpdate: Restrict)
  factLinks        AssessmentCaseFactEvidence[]

  @@unique([evidenceId, assessmentId])
  @@index([assessmentId, state])
}

model AssessmentCaseFact {
  factId         String                       @id @db.Uuid
  assessmentId   String
  caseRevision   Int
  kind           AssessmentFactKind
  authority      AssessmentFactAuthority
  state          AssessmentRecordState        @default(ACCEPTED)
  statement      String
  createdAt      DateTime                     @default(now()) @db.Timestamptz(3)
  invalidatedAt  DateTime?                    @db.Timestamptz(3)
  assessmentCase AssessmentCase               @relation(fields: [assessmentId], references: [assessmentId], onDelete: Cascade, onUpdate: Restrict)
  evidenceLinks  AssessmentCaseFactEvidence[]

  // Every accepted fact is exactly one case revision.
  @@unique([assessmentId, caseRevision])
  @@unique([factId, assessmentId])
}

model AssessmentCaseFactEvidence {
  assessmentId String
  factId       String             @db.Uuid
  evidenceId   String             @db.Uuid
  fact         AssessmentCaseFact @relation(fields: [factId, assessmentId], references: [factId, assessmentId], onDelete: Cascade, onUpdate: Restrict)
  evidence     AssessmentEvidence @relation(fields: [evidenceId, assessmentId], references: [evidenceId, assessmentId], onDelete: Cascade, onUpdate: Restrict)

  @@id([factId, evidenceId])
  @@index([evidenceId])
}

/// Latest ACCEPTED decision per (assessment, rule, scope) plus immutable history.
model AssessmentRuleDecision {
  decisionId            String                         @id @db.Uuid
  assessmentId          String
  ruleSetVersionId      String
  assessmentRuleId      String
  assessmentRuleVersion String
  scopeId               String
  decisionRevision      Int
  state                 AssessmentDecisionRecordState  @default(ACCEPTED)
  applicability         RuleDecisionApplicability
  compliance            RuleDecisionComplianceOutcome?
  repositoryCommit      String
  caseRevision          Int
  idempotencyKey        String
  requestDigest         String
  decision              Json
  createdAt             DateTime                       @default(now()) @db.Timestamptz(3)
  supersededAt          DateTime?                      @db.Timestamptz(3)
  invalidatedAt         DateTime?                      @db.Timestamptz(3)
  assessmentCase        AssessmentCase                 @relation(fields: [assessmentId, ruleSetVersionId], references: [assessmentId, ruleSetVersionId], onDelete: Cascade, onUpdate: Restrict)
  assessmentRule        AssessmentRule                 @relation(fields: [ruleSetVersionId, assessmentRuleId], references: [ruleSetVersionId, assessmentRuleId], onDelete: Restrict, onUpdate: Restrict)
  currentFor            AssessmentDecisionCoverage[]

  @@unique([assessmentId, assessmentRuleId, scopeId, decisionRevision])
  @@unique([assessmentId, idempotencyKey])
  @@unique([decisionId, assessmentId])
  @@index([assessmentId, state])
}

/// Decision-resolution coverage: one row per AssessmentRule of the pinned rule set, created in
/// the preparation transaction so the Root provably covers the whole rule set.
model AssessmentDecisionCoverage {
  assessmentId          String
  assessmentRuleId      String
  ruleSetVersionId      String
  assessmentRuleVersion String
  resolutionState       DecisionResolutionState @default(PENDING)
  currentDecisionId     String?                 @db.Uuid
  decisionRevision      Int                     @default(0)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(3)
  assessmentCase        AssessmentCase          @relation(fields: [assessmentId, ruleSetVersionId], references: [assessmentId, ruleSetVersionId], onDelete: Cascade, onUpdate: Restrict)
  assessmentRule        AssessmentRule          @relation(fields: [ruleSetVersionId, assessmentRuleId], references: [ruleSetVersionId, assessmentRuleId], onDelete: Restrict, onUpdate: Restrict)
  currentDecision       AssessmentRuleDecision? @relation(fields: [currentDecisionId, assessmentId], references: [decisionId, assessmentId], onDelete: NoAction, onUpdate: Restrict)

  @@id([assessmentId, assessmentRuleId])
  @@index([assessmentId, resolutionState])
}

// resolvedFactId also carries a raw composite FK (resolvedFactId, assessmentId) ->
// AssessmentCaseFact(factId, assessmentId) in the migrations (no Prisma relation), next to the
// AssessmentHumanRequest_resolved_shape CHECK. Restored by
// 20261014090000_restore_human_request_resolved_fact_fk after re_generate_db dropped it.
model AssessmentHumanRequest {
  requestId          String                       @id @db.Uuid
  assessmentId       String
  threadId           String                       @db.Uuid
  status             HumanResolutionRequestStatus @default(OPEN)
  caseRevision       Int
  assessmentRuleId   String
  criterionIds       Json
  question           String
  unresolvedFact     String
  decisionImpact     Json
  resolutionAttempts Json
  controlType        String
  choices            Json
  answers            Json                         @default("[]")
  resolvedFactId     String?                      @db.Uuid
  requestRevision    Int                          @default(0)
  idempotencyKey     String?
  requestDigest      String?
  checkpointId       String?                      @db.Uuid
  createdAt          DateTime                     @default(now()) @db.Timestamptz(3)
  resolvedAt         DateTime?                    @db.Timestamptz(3)
  assessmentCase     AssessmentCase               @relation(fields: [assessmentId], references: [assessmentId], onDelete: Cascade, onUpdate: Restrict)
  runtime            AssessmentRuntime            @relation(fields: [assessmentId, threadId], references: [assessmentId, threadId], onDelete: Cascade, onUpdate: Restrict)

  @@unique([assessmentId, idempotencyKey])
  @@index([assessmentId, status])
}

/// Artifact metadata only; bytes live in the one protected blob store. Assessment Root owns generation.
model AssessmentArtifact {
  artifactId           String                 @id @db.Uuid
  assessmentId         String
  kind                 AssessmentArtifactKind
  lifecycleState       ArtifactLifecycleState @default(BUILDING)
  ruleSetVersionId     String
  repositorySnapshotId String
  repositoryCommit     String
  caseRevision         Int
  schemaVersion        String
  reportRequestDigest  String?
  contentSha256        String?
  sizeBytes            Int?
  storageRef           String?
  createdAt            DateTime               @default(now()) @db.Timestamptz(3)
  activatedAt          DateTime?              @db.Timestamptz(3)
  assessmentCase       AssessmentCase         @relation(fields: [assessmentId, ruleSetVersionId], references: [assessmentId, ruleSetVersionId], onDelete: Cascade, onUpdate: Restrict)

  @@unique([assessmentId, kind])
  @@index([assessmentId, lifecycleState])
}

/// One execution of the forward-migration tooling (rehearsal on a copy, or the real cutover).

/// One row per V1 assessment after migration: terminal ones are archived read-only; non-terminal ones
/// continue in V2 (fresh thread/state) while their V1 history stays here.

/// Byte-exact `to_jsonb` copy of one V1 row (or, for report-related rows, its reconciliation outcome).

/// Bytes that actually existed in V1 storage and were copied with verified identity. Never fabricated.

/// Coordination ledger of the SEPARATE, explicit re-evaluation phase: which migrated assessment an operator
/// deliberately started, when, by whom and in which batch. It never stores execution, completion or failure:
/// those stay canonical (ALS/AES) and are only derived from. The Root is the sole semantic authority.

enum AuthorizationReasonCode {
  ACCOUNT_SUSPENDED
  ACTION_NOT_GRANTED
  ACCOUNT_NOT_FOUND
  AUTHORIZED
  AUTHZ_EVALUATOR_FAILURE
  AUTHZ_STATE_GATE_BLOCKED
  AUTH_REQUIRED
  EMAIL_VERIFICATION_REQUIRED
  EVALUATOR_ERROR
  INVALID_CREDENTIALS
  INVALID_INVITE_STATE
  INVALID_REDIRECT_URI
  LOAD_ERROR
  MFA_REQUIRED
  MFA_INVALID
  MFA_RATE_LIMITED
  OAUTH_CALLBACK_INVALID
  OAUTH_STATE_INVALID
  RBAC_DENIED
  RBAC_METADATA_MISSING
  REAUTH_REQUIRED
  RECOVERY_INVALID
  SESSION_INVALID
  STATE_GATE_FAILED
  SUBJECT_ROLE_MISMATCH
  TEMPORARY_LOCKED
  UNSUPPORTED_PROVIDER
  VALIDATION_FAILED
}
