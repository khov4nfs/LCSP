{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "test/**/*.mjs",
    "scripts/**/*.ts",
    "scripts/**/*.mjs",
    "jest.config.ts",
    "prisma.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
