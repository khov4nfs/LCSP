{
  "title": "LegalPortfolioToolInput",
  "type": "object",
  "properties": {
    "packet": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "legalRules": {
          "description": "Operative duties, prohibitions or permissions only. Context-only definitions, scope, exceptions and interpretive cross-references belong in contextRelations with toSourceRef, not standalone LegalRules. Source coverage does not require a LegalRule for every provision.",
          "maxItems": 5000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "legalRuleId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "proposition": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "applicabilityConditions": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "qualifiers": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "exceptions": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "nonRepositoryDuty": {
                "description": "Whether the duty requires organizational, human, physical or external action that repository/software evidence cannot establish. A software record of an action does not establish performance of that action or create a software obligation absent from the source.",
                "type": "boolean"
              },
              "sourceRefs": {
                "minItems": 1,
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "documentId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                    },
                    "locator": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "contentSha256": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "documentId",
                    "locator",
                    "contentSha256"
                  ],
                  "additionalProperties": false
                }
              },
              "coverage": {
                "type": "object",
                "properties": {
                  "state": {
                    "description": "COVERED_BY_ENGINEERING_RULES requires at least one EngineeringRule legalRuleIds reference; NON_ASSESSABLE requires none. The model decides legal assessability.",
                    "type": "string",
                    "enum": [
                      "COVERED_BY_ENGINEERING_RULES",
                      "NON_ASSESSABLE"
                    ]
                  },
                  "nonAssessableReason": {
                    "description": "Must be null when state is COVERED_BY_ENGINEERING_RULES; must be a non-blank reason when state is NON_ASSESSABLE.",
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 8000
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "state",
                  "nonAssessableReason"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "legalRuleId",
              "title",
              "proposition",
              "applicabilityConditions",
              "qualifiers",
              "exceptions",
              "nonRepositoryDuty",
              "sourceRefs",
              "coverage"
            ],
            "additionalProperties": false
          }
        },
        "engineeringRules": {
          "maxItems": 20000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "engineeringRuleId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "legalRuleIds": {
                "description": "LegalRule IDs covered by this EngineeringRule; never reference a LegalRule declared NON_ASSESSABLE.",
                "minItems": 1,
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                }
              },
              "concept": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "legalIntent": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "applicabilityGuidance": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "criteria": {
                "minItems": 1,
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "criterionId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                    },
                    "statement": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 8000
                    }
                  },
                  "required": [
                    "criterionId",
                    "statement"
                  ],
                  "additionalProperties": false
                }
              },
              "investigationGoals": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "startingNodeTypes": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "targetNodeTypes": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "edgeStrategies": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "graphQueries": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "startNodeTypes": {
                      "maxItems": 64,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512
                      }
                    },
                    "direction": {
                      "type": "string",
                      "enum": [
                        "FORWARD",
                        "BACKWARD",
                        "BOTH"
                      ]
                    },
                    "followEdges": {
                      "maxItems": 64,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512
                      }
                    },
                    "stopNodeTypes": {
                      "maxItems": 64,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512
                      }
                    },
                    "semanticTypes": {
                      "maxItems": 64,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512
                      }
                    }
                  },
                  "required": [
                    "name",
                    "startNodeTypes",
                    "direction",
                    "followEdges",
                    "stopNodeTypes",
                    "semanticTypes"
                  ],
                  "additionalProperties": false
                }
              },
              "keywords": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "commonApis": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "commonLibraries": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "patterns": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "requiredEvidence": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "supportingEvidence": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "negativeEvidence": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "unresolvedConditions": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "sourceRefs": {
                "minItems": 1,
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "documentId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                    },
                    "locator": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "contentSha256": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "documentId",
                    "locator",
                    "contentSha256"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "engineeringRuleId",
              "legalRuleIds",
              "concept",
              "legalIntent",
              "applicabilityGuidance",
              "criteria",
              "investigationGoals",
              "startingNodeTypes",
              "targetNodeTypes",
              "edgeStrategies",
              "graphQueries",
              "keywords",
              "commonApis",
              "commonLibraries",
              "patterns",
              "requiredEvidence",
              "supportingEvidence",
              "negativeEvidence",
              "unresolvedConditions",
              "sourceRefs"
            ],
            "additionalProperties": false
          }
        },
        "contextRelations": {
          "maxItems": 20000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "relationId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "DEFINITION",
                  "SCOPE",
                  "QUALIFIER",
                  "EXCEPTION",
                  "CROSS_REFERENCE"
                ]
              },
              "fromLegalRuleId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "toLegalRuleId": {
                "description": "Target an independently operative LegalRule only. For a context-only provision use toSourceRef and set this field to explicit JSON null; never create a LegalRule merely as a relation target.",
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "toSourceRef": {
                "description": "Exact pinned source reference for a context-only definition, scope, qualifier, exception or cross-reference. Set toLegalRuleId to explicit JSON null. When targeting an independently operative LegalRule, this field is explicit JSON null.",
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "documentId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                      },
                      "locator": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512
                      },
                      "contentSha256": {
                        "type": "string",
                        "pattern": "^sha256:[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "documentId",
                      "locator",
                      "contentSha256"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "relationId",
              "kind",
              "fromLegalRuleId",
              "toLegalRuleId",
              "toSourceRef"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "legalRules",
        "engineeringRules",
        "contextRelations"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "packet"
  ],
  "additionalProperties": false
}
