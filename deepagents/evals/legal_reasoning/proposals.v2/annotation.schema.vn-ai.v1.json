{
  "$defs": {
    "expectation": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "confidence": {
              "enum": [
                "CANDIDATE",
                "UNCERTAIN"
              ]
            },
            "details": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "label": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "label",
            "details"
          ],
          "type": "object"
        }
      ]
    },
    "expectedDimensions": {
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "actor": {
          "$ref": "#/$defs/expectation"
        },
        "applicability": {
          "$ref": "#/$defs/expectation"
        },
        "compliance": {
          "$ref": "#/$defs/expectation"
        },
        "conditions": {
          "$ref": "#/$defs/expectation"
        },
        "evidenceSufficiency": {
          "$ref": "#/$defs/expectation"
        },
        "exceptions": {
          "$ref": "#/$defs/expectation"
        },
        "unsupportedConclusion": {
          "$ref": "#/$defs/expectation"
        }
      },
      "type": "object"
    }
  },
  "$id": "https://lcsp.example/evals/legal-reasoning/annotation.schema.vn-ai.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adjudication": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "adjudicatedAt": {
              "format": "date-time",
              "pattern": "(?:Z|\\+00:00)$",
              "type": "string"
            },
            "identityVerificationRef": {
              "pattern": "^(?:https://[^\\s]+|urn:lcsp-review:[A-Za-z0-9._:/-]+|synthetic-fixture-only://[A-Za-z0-9._:/-]+)$",
              "type": "string"
            },
            "outcome": {
              "enum": [
                "CONFIRM",
                "REVISE",
                "EXCLUDE",
                "REMAIN_UNCERTAIN"
              ]
            },
            "rationale": {
              "minLength": 1,
              "type": "string"
            },
            "resolvedLabels": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "dimension": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "label": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "priorLabel": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "rationale": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "dimension",
                  "label",
                  "rationale"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "reviewEvidenceRef": {
              "pattern": "^(?:https://[^\\s]+|urn:lcsp-review:[A-Za-z0-9._:/-]+|synthetic-fixture-only://[A-Za-z0-9._:/-]+)$",
              "type": "string"
            },
            "reviewerId": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{1,127}$",
              "type": "string"
            },
            "reviewerType": {
              "const": "HUMAN"
            }
          },
          "required": [
            "reviewerType",
            "reviewerId",
            "identityVerificationRef",
            "reviewEvidenceRef",
            "outcome",
            "rationale",
            "adjudicatedAt",
            "resolvedLabels"
          ],
          "type": "object"
        }
      ]
    },
    "annotationRationale": {
      "minLength": 20,
      "type": "string"
    },
    "caseDescription": {
      "minLength": 20,
      "type": "string"
    },
    "caseId": {
      "pattern": "^[a-z0-9][a-z0-9-]{2,95}$",
      "type": "string"
    },
    "claimUnderReview": {
      "type": [
        "string",
        "null"
      ]
    },
    "counterfactualPair": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "changedMaterialFact": {
              "minLength": 1,
              "type": "string"
            },
            "counterpartCaseId": {
              "minLength": 1,
              "type": "string"
            },
            "pairId": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "pairId",
            "counterpartCaseId",
            "changedMaterialFact"
          ],
          "type": "object"
        }
      ]
    },
    "datasetVersion": {
      "const": "LCSP-400-VIETNAM-AI-CANDIDATES-V1"
    },
    "evaluationTarget": {
      "enum": [
        "ACTUAL_ASSESSMENT_OUTPUT",
        "RULE_SET_PREPARATION_OUTPUT",
        "FIXED_CLAIM_DIAGNOSTIC",
        "SYNTHETIC_SCORER_VERIFICATION"
      ]
    },
    "evidenceReferences": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "minLength": 1,
            "type": "string"
          },
          "kind": {
            "enum": [
              "PUBLIC_LEGAL_SOURCE",
              "SYNTHETIC_SCENARIO_FACT",
              "SYNTHETIC_REPOSITORY_EVIDENCE"
            ]
          },
          "referenceId": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "referenceId",
          "kind",
          "description"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "exclusionReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "executionBinding": {
      "additionalProperties": false,
      "properties": {
        "evaluationStage": {
          "const": "ASSESSMENT_ROOT"
        },
        "fixtureFingerprints": {
          "additionalProperties": false,
          "properties": {
            "legalSourceSha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "p14CaseSha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "provisionContentSha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "repositorySnapshotSha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "scenarioSha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "targetPropositionSha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "targetRuleSha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          },
          "required": [
            "legalSourceSha256",
            "provisionContentSha256",
            "targetPropositionSha256",
            "targetRuleSha256",
            "scenarioSha256",
            "repositorySnapshotSha256",
            "p14CaseSha256"
          ],
          "type": "object"
        },
        "lifecycleStage": {
          "enum": [
            "INITIAL",
            "WAITING_FOR_HUMAN",
            "RESUME_FINAL",
            "FAULT_RECOVERY"
          ]
        },
        "p14CaseId": {
          "minLength": 1,
          "type": "string"
        },
        "releaseEvidenceSha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "targetRuleId": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "p14CaseId",
        "evaluationStage",
        "lifecycleStage",
        "targetRuleId",
        "fixtureFingerprints",
        "releaseEvidenceSha256"
      ],
      "type": "object"
    },
    "expected": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "$ref": "#/$defs/expectation"
        },
        "applicability": {
          "$ref": "#/$defs/expectation"
        },
        "compliance": {
          "$ref": "#/$defs/expectation"
        },
        "conditions": {
          "$ref": "#/$defs/expectation"
        },
        "evidenceSufficiency": {
          "$ref": "#/$defs/expectation"
        },
        "exceptions": {
          "$ref": "#/$defs/expectation"
        },
        "unsupportedConclusion": {
          "$ref": "#/$defs/expectation"
        }
      },
      "type": "object"
    },
    "fixedOutputDiagnostic": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "diagnosticKind": {
              "const": "PREDEFINED_CLAIM_ONLY"
            },
            "expectedJudgments": {
              "$ref": "#/$defs/expectedDimensions"
            }
          },
          "required": [
            "diagnosticKind",
            "expectedJudgments"
          ],
          "type": "object"
        }
      ]
    },
    "legalSource": {
      "additionalProperties": false,
      "properties": {
        "citations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "provisionRefs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "sourceId": {
          "minLength": 1,
          "type": "string"
        },
        "sourceUrl": {
          "format": "uri",
          "type": "string"
        },
        "sourceVersion": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "sourceId",
        "sourceVersion",
        "sourceUrl",
        "citations",
        "provisionRefs"
      ],
      "type": "object"
    },
    "primaryDimension": {
      "enum": [
        "APPLICABILITY",
        "COMPLIANCE",
        "ACTOR",
        "CONDITIONS",
        "EXCEPTIONS",
        "EVIDENCE_SUFFICIENCY",
        "UNSUPPORTED_CONCLUSION"
      ]
    },
    "relatedLegalSources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "citations": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "provisionRefs": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "sourceId": {
            "minLength": 1,
            "type": "string"
          },
          "sourceUrl": {
            "format": "uri",
            "type": "string"
          },
          "sourceVersion": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "sourceId",
          "sourceVersion",
          "sourceUrl",
          "citations",
          "provisionRefs"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "reviewStatus": {
      "enum": [
        "CANDIDATE",
        "INDEPENDENT_REVIEW",
        "REVIEWED",
        "ADJUDICATED",
        "PROVISIONAL",
        "UNCERTAIN",
        "EXCLUDED"
      ]
    },
    "reviewerDisagreements": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "dimension": {
            "minLength": 1,
            "type": "string"
          },
          "issue": {
            "minLength": 1,
            "type": "string"
          },
          "proposedLabels": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string"
                },
                "reviewerId": {
                  "type": "string"
                }
              },
              "required": [
                "reviewerId",
                "label"
              ],
              "type": "object"
            },
            "minItems": 2,
            "type": "array"
          },
          "reviewerIds": {
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "dimension",
          "reviewerIds",
          "issue",
          "proposedLabels"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "reviewers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "decision": {
            "enum": [
              "CONFIRM",
              "REVISE",
              "UNSURE"
            ]
          },
          "dimensionJudgments": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "dimension": {
                  "minLength": 1,
                  "type": "string"
                },
                "label": {
                  "minLength": 1,
                  "type": "string"
                },
                "priorLabel": {
                  "minLength": 1,
                  "type": "string"
                },
                "rationale": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "dimension",
                "label",
                "rationale"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "dimensionsReviewed": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "identityVerificationRef": {
            "pattern": "^(?:https://[^\\s]+|urn:lcsp-review:[A-Za-z0-9._:/-]+|synthetic-fixture-only://[A-Za-z0-9._:/-]+)$",
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "reviewedAt": {
            "format": "date-time",
            "pattern": "(?:Z|\\+00:00)$",
            "type": "string"
          },
          "reviewerId": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{1,127}$",
            "type": "string"
          },
          "reviewerType": {
            "const": "HUMAN"
          }
        },
        "required": [
          "reviewerType",
          "reviewerId",
          "identityVerificationRef",
          "reviewedAt",
          "decision",
          "dimensionsReviewed",
          "dimensionJudgments"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "rubricVersion": {
      "const": "LCSP-400-LEGAL-REASONING-RUBRIC-VN-AI-V1"
    },
    "scenarioFacts": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "semanticGroupId": {
      "minLength": 1,
      "type": "string"
    },
    "stage": {
      "enum": [
        "RULE_SET_PREPARATION",
        "ASSESSMENT_ROOT"
      ]
    },
    "targetObligation": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "minLength": 1,
          "type": "string"
        },
        "conditions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "exceptions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "proposition": {
          "minLength": 1,
          "type": "string"
        },
        "provisionRefs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "semanticGroupId": {
          "minLength": 1,
          "type": "string"
        },
        "targetRuleId": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "targetRuleId",
        "proposition",
        "actor",
        "conditions",
        "exceptions",
        "provisionRefs",
        "semanticGroupId"
      ],
      "type": "object"
    },
    "uncertaintyReason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "caseId",
    "datasetVersion",
    "rubricVersion",
    "stage",
    "evaluationTarget",
    "primaryDimension",
    "caseDescription",
    "legalSource",
    "scenarioFacts",
    "claimUnderReview",
    "fixedOutputDiagnostic",
    "expected",
    "annotationRationale",
    "evidenceReferences",
    "reviewStatus",
    "reviewers",
    "reviewerDisagreements",
    "adjudication",
    "uncertaintyReason",
    "exclusionReason",
    "counterfactualPair",
    "relatedLegalSources",
    "targetObligation",
    "semanticGroupId",
    "executionBinding"
  ],
  "title": "LCSP-400 Vietnamese AI law candidate annotation",
  "type": "object"
}
