{
  "title": "ComplianceRuleSetToolInput",
  "type": "object",
  "properties": {
    "packet": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "semanticGraph": {
          "type": "object",
          "properties": {
            "contractVersion": {
              "type": "string",
              "const": "LEGAL_GRAPH_V2"
            },
            "materializationId": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "legalSourceVersionId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
            },
            "claims": {
              "minItems": 1,
              "maxItems": 20000,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "claimId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  "legalSourceVersionId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
                  },
                  "sourceNodeIds": {
                    "minItems": 1,
                    "maxItems": 64,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "claimType": {
                    "type": "string",
                    "enum": [
                      "DUTY",
                      "PROHIBITION",
                      "PERMISSION",
                      "DEFINITION",
                      "SCOPE",
                      "QUALIFIER",
                      "EXCEPTION",
                      "CROSS_REFERENCE",
                      "CONDITION",
                      "TEMPORAL_RULE",
                      "TRANSITION_RULE",
                      "CONTEXT"
                    ]
                  },
                  "statement": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8000
                  },
                  "operative": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "actor": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 8000
                          },
                          "modality": {
                            "type": "string",
                            "enum": ["DUTY", "PROHIBITION", "PERMISSION"]
                          },
                          "action": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 8000
                          }
                        },
                        "required": ["actor", "modality", "action"],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "state": {
                    "type": "string",
                    "enum": ["RELEVANT", "INTENTIONALLY_NON_OPERATIVE"]
                  },
                  "nonOperativeReason": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 8000
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "claimId",
                  "legalSourceVersionId",
                  "sourceNodeIds",
                  "claimType",
                  "statement",
                  "operative",
                  "state",
                  "nonOperativeReason"
                ],
                "additionalProperties": false
              }
            },
            "relations": {
              "maxItems": 40000,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "relationId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "DEFINITION",
                      "SCOPE",
                      "QUALIFIER",
                      "EXCEPTION",
                      "CROSS_REFERENCE",
                      "CONDITION",
                      "INCORPORATES",
                      "TEMPORALLY_LIMITS"
                    ]
                  },
                  "fromClaimId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  "toClaimId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  "referenceId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "relationId",
                  "kind",
                  "fromClaimId",
                  "toClaimId",
                  "referenceId"
                ],
                "additionalProperties": false
              }
            },
            "sourceAccounting": {
              "description": "Explicit Agent inspection of every source node containing text: list ALL identified claims, or a reason that it contains no relevant semantic material. One context claim does not account for another duty in the same node.",
              "maxItems": 40000,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "sourceNodeId": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "claimIds": {
                    "maxItems": 128,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                    }
                  },
                  "nonSemanticReason": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 8000
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": ["sourceNodeId", "claimIds", "nonSemanticReason"],
                "additionalProperties": false
              }
            },
            "referenceAccounting": {
              "description": "Inspect explicit references. Every material reference requires resolved targets and directed semantic dependencies. Non-material references require an Agent-authored reason.",
              "maxItems": 40000,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "referenceId": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "material": {
                    "type": "boolean"
                  },
                  "relationIds": {
                    "maxItems": 128,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                    }
                  },
                  "nonMaterialReason": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 8000
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "referenceId",
                  "material",
                  "relationIds",
                  "nonMaterialReason"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "contractVersion",
            "materializationId",
            "legalSourceVersionId",
            "claims",
            "relations",
            "sourceAccounting",
            "referenceAccounting"
          ],
          "additionalProperties": false
        },
        "claimInventory": {
          "type": "object",
          "properties": {
            "revision": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "fingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": ["revision", "fingerprint"],
          "additionalProperties": false
        },
        "legalRequirements": {
          "description": "Operative duties, prohibitions or permissions only. Context-only definitions, scope, exceptions and interpretive cross-references belong in contextRelations with toSourceRef, not standalone LegalRequirements. Source coverage does not require a LegalRequirement for every provision.",
          "maxItems": 5000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "legalRequirementId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "claimInventoryRevision": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "claimBindings": {
                "maxItems": 256,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "claimId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "OPERATIVE_PROPOSITION",
                        "APPLICABILITY_CONDITION",
                        "QUALIFIER",
                        "EXCEPTION",
                        "CONTEXT",
                        "DEFINITION"
                      ]
                    },
                    "index": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["claimId", "role", "index"],
                  "additionalProperties": false
                }
              },
              "semanticContext": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "proposition": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "operativePropositions": {
                "description": "Required for new Rule Set authoring, including NON_ASSESSABLE duties: at least one explicit actor/modality/action with pinned source bindings. Multiple propositions may be aggregated in one LegalRequirement. Context-only sources belong in typed contextRelations, never a placeholder requirement. Missing structure returns OPERATIVE_PROPOSITION_REQUIRED.",
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "actor": {
                      "description": "The source's actual addressee/subject, including a defined role's criteria. Non-repository and public-body duties still have an actor.",
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 8000
                    },
                    "modality": {
                      "description": "Agent's interpretation of the normative force, not repository assessability.",
                      "type": "string",
                      "enum": ["DUTY", "PROHIBITION", "PERMISSION"]
                    },
                    "action": {
                      "description": "The operative action and object/scope: what must, must not, or may be done. Preserve distinct propositions; do not describe citation coverage or generic context.",
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 8000
                    },
                    "sourceRefs": {
                      "description": "Optional exact legacy retrieval citations, also declared in the owning LegalRequirement sourceRefs. Claim bindings to immutable source nodes are the canonical provenance; use [] when a structural node has no legacy chunk.",
                      "default": [],
                      "maxItems": 64,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "documentId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128,
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                          },
                          "locator": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 512
                          },
                          "contentSha256": {
                            "type": "string",
                            "pattern": "^sha256:[a-f0-9]{64}$"
                          }
                        },
                        "required": ["documentId", "locator", "contentSha256"],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": ["actor", "modality", "action"],
                  "additionalProperties": false
                }
              },
              "applicabilityConditions": {
                "description": "Whom or what the source applies this provision to and what triggers it, as facts that evidence can establish or refute, in the source's own terms (any-of / all-of exactly as written). When the source names a role, class, category, status, threshold or sector and defines or enumerates its criteria, unpack those criteria here and cite the defining provision in sourceRefs; a label is never its own explanation. Required (at least one) when assessment rules cover the requirement; if the source adds no further condition, state the addressee it names.",
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "qualifiers": {
                "description": "Timing, actor, modality or degree limits the source places on the duty itself.",
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "exceptions": {
                "description": "Each exemption, exclusion or carve-out the source gives for THIS duty, with its own limiting words and the facts that would establish it. Empty when the source gives none.",
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "nonRepositoryDuty": {
                "description": "Whether the duty requires organizational, human, physical or external action that repository/software evidence cannot establish. A software record of an action does not establish performance of that action or create a software obligation absent from the source.",
                "type": "boolean"
              },
              "sourceRefs": {
                "default": [],
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "documentId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                    },
                    "locator": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "contentSha256": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    }
                  },
                  "required": ["documentId", "locator", "contentSha256"],
                  "additionalProperties": false
                }
              },
              "coverage": {
                "type": "object",
                "properties": {
                  "state": {
                    "description": "COVERED_BY_ASSESSMENT_RULES requires at least one AssessmentRule legalRequirementIds reference; NON_ASSESSABLE requires none. The model decides legal assessability.",
                    "type": "string",
                    "enum": ["COVERED_BY_ASSESSMENT_RULES", "NON_ASSESSABLE"]
                  },
                  "nonAssessableReason": {
                    "description": "Must be null when state is COVERED_BY_ASSESSMENT_RULES; must be a non-blank reason when state is NON_ASSESSABLE.",
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 8000
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": ["state", "nonAssessableReason"],
                "additionalProperties": false
              }
            },
            "required": [
              "legalRequirementId",
              "title",
              "proposition",
              "applicabilityConditions",
              "qualifiers",
              "exceptions",
              "nonRepositoryDuty",
              "coverage"
            ],
            "additionalProperties": false
          }
        },
        "assessmentRules": {
          "maxItems": 20000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "assessmentRuleId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "evidenceBindings": {
                "maxItems": 256,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "criterionId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                    },
                    "kind": {
                      "type": "string",
                      "enum": ["REQUIRED", "SUPPORTING", "NEGATIVE"]
                    }
                  },
                  "required": ["criterionId", "kind"],
                  "additionalProperties": false
                }
              },
              "semanticAuthority": {
                "type": "string",
                "const": "CLAIM_DERIVED"
              },
              "legalRequirementIds": {
                "description": "LegalRequirement IDs covered by this AssessmentRule; never reference a LegalRequirement declared NON_ASSESSABLE.",
                "minItems": 1,
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                }
              },
              "concept": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "legalIntent": {
                "description": "Omit. Server derives intent from linked parent propositions; supplied contradictions return APPLICABILITY_BINDING_MISMATCH.",
                "type": "string",
                "minLength": 1
              },
              "contextRelationIds": {
                "description": "Canonical inherited directed context dependency IDs, including incorporation. Omit to derive; supplied omissions or reversals return APPLICABILITY_BINDING_MISMATCH.",
                "maxItems": 20000,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                }
              },
              "unresolvedConditionBindings": {
                "description": "Select parent context facts that require external/customer evidence using stable requirement ID, field and zero-based index. The server renders unresolvedConditions from these facts; no independently paraphrased actor, trigger, qualifier or exception.",
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "legalRequirementId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                    },
                    "field": {
                      "type": "string",
                      "enum": [
                        "APPLICABILITY_CONDITION",
                        "QUALIFIER",
                        "EXCEPTION"
                      ]
                    },
                    "index": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["legalRequirementId", "field", "index"],
                  "additionalProperties": false
                }
              },
              "applicabilityGuidance": {
                "description": "Omit this field. The server derives guidance from all linked legalRequirementIds, preserving their actors, direction, conditions, qualifiers and exceptions. Supplied text must equal that canonical rendering or returns APPLICABILITY_BINDING_MISMATCH; it is never silently replaced.",
                "type": "string",
                "minLength": 1
              },
              "criteria": {
                "minItems": 1,
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "criterionId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                    },
                    "legalRequirementIds": {
                      "description": "Required for new authoring: parent LegalRequirement IDs whose complete normative propositions this criterion evaluates. Must be a subset of the AssessmentRule legalRequirementIds. All parent scope, purpose, conditions and exceptions are inherited; never independently rewrite a broader obligation.",
                      "minItems": 1,
                      "maxItems": 64,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                      }
                    },
                    "statement": {
                      "description": "Omit this field. The server derives the complete normative statement from this criterion's legalRequirementIds, retaining purpose/scope restrictions, conditions and exceptions. Supplied text must equal that rendering or returns APPLICABILITY_BINDING_MISMATCH. Put a narrower technical evidence focus in investigationFocus.",
                      "type": "string",
                      "minLength": 1
                    },
                    "investigationFocus": {
                      "description": "Optional narrower evidence focus within the inherited normative statement, such as one storage surface or control. An investigation strategy, never a replacement legal predicate or a new obligation, exception or threshold.",
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 8000
                    }
                  },
                  "required": ["criterionId"],
                  "additionalProperties": false
                }
              },
              "investigationGoals": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "startingNodeTypes": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "targetNodeTypes": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "edgeStrategies": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "graphQueries": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "startNodeTypes": {
                      "maxItems": 64,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512
                      }
                    },
                    "direction": {
                      "type": "string",
                      "enum": ["FORWARD", "BACKWARD", "BOTH"]
                    },
                    "followEdges": {
                      "maxItems": 64,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512
                      }
                    },
                    "stopNodeTypes": {
                      "maxItems": 64,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512
                      }
                    },
                    "semanticTypes": {
                      "maxItems": 64,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512
                      }
                    }
                  },
                  "required": [
                    "name",
                    "startNodeTypes",
                    "direction",
                    "followEdges",
                    "stopNodeTypes",
                    "semanticTypes"
                  ],
                  "additionalProperties": false
                }
              },
              "keywords": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "commonApis": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "commonLibraries": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "patterns": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "requiredEvidence": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "supportingEvidence": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "negativeEvidence": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "unresolvedConditions": {
                "description": "Omit. Select unresolvedConditionBindings instead; server renders the exact parent facts. An empty binding list means no separate unresolved facts, not unconditional applicability; complete parent context remains mandatory.",
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "sourceRefs": {
                "default": [],
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "documentId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                    },
                    "locator": {
                      "type": "string",
                      "minLength": 1,
