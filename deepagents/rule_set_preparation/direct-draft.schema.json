{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "packageId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidates": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidateId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "obligations": {
            "minItems": 1,
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "statement": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "support": {
                  "minItems": 1,
                  "maxItems": 64,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "nodeId": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 8000
                      }
                    },
                    "required": [
                      "nodeId",
                      "quote"
                    ],
                    "additionalProperties": false
                  }
                },
                "actor": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "modality": {
                  "type": "string",
                  "enum": [
                    "DUTY",
                    "PROHIBITION",
                    "PERMISSION"
                  ]
                },
                "action": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                }
              },
              "required": [
                "statement",
                "support",
                "actor",
                "modality",
                "action"
              ],
              "additionalProperties": false
            }
          },
          "applicability": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "UNCONDITIONAL",
                  "CONDITIONAL"
                ]
              },
              "conditions": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "statement": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 8000
                    },
                    "support": {
                      "minItems": 1,
                      "maxItems": 64,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "nodeId": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          },
                          "quote": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 8000
                          }
                        },
                        "required": [
                          "nodeId",
                          "quote"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "statement",
                    "support"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "mode",
              "conditions"
            ],
            "additionalProperties": false
          },
          "qualifiers": {
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "statement": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "support": {
                  "minItems": 1,
                  "maxItems": 64,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "nodeId": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 8000
                      }
                    },
                    "required": [
                      "nodeId",
                      "quote"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "statement",
                "support"
              ],
              "additionalProperties": false
            }
          },
          "exceptions": {
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "statement": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "support": {
                  "minItems": 1,
                  "maxItems": 64,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "nodeId": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 8000
                      }
                    },
                    "required": [
                      "nodeId",
                      "quote"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "statement",
                "support"
              ],
              "additionalProperties": false
            }
          },
          "definitions": {
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "statement": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "support": {
                  "minItems": 1,
                  "maxItems": 64,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "nodeId": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 8000
                      }
                    },
                    "required": [
                      "nodeId",
                      "quote"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "statement",
                "support"
              ],
              "additionalProperties": false
            }
          },
          "repositoryAssessability": {
            "type": "string",
            "enum": [
              "REPOSITORY_VERIFIABLE",
              "EXTERNAL_FULFILLMENT",
              "MIXED",
              "NON_ASSESSABLE"
            ]
          },
          "repositoryObservableAspect": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              {
                "type": "null"
              }
            ]
          },
          "externalFulfillmentAspect": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              {
                "type": "null"
              }
            ]
          },
          "nonAssessableReason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              {
                "type": "null"
              }
            ]
          },
          "assessmentRule": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "assessmentRuleId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  "concept": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "investigationFocus": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 8000
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "assessmentRuleId",
                  "concept",
                  "investigationFocus"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "candidateId",
          "title",
          "obligations",
          "applicability",
          "qualifiers",
          "exceptions",
          "definitions",
          "repositoryAssessability",
          "nonAssessableReason",
          "assessmentRule"
        ],
        "additionalProperties": false
      }
    },
    "removeCandidateIds": {
      "default": [],
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    },
    "legalEffects": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "support": {
            "minItems": 1,
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "nodeId": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                }
              },
              "required": [
                "nodeId",
                "quote"
              ],
              "additionalProperties": false
            }
          },
          "effectId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "legalEffect": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "AMENDS",
                  "REPEALS",
                  "REPLACES",
                  "SUPPLEMENTS",
                  "SUSPENDS",
                  "REFERENCES"
                ]
              },
              "targets": {
                "maxItems": 128,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "nodeId": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "scope": {
                      "type": "string",
                      "enum": [
                        "EXACT",
                        "SUBTREE"
                      ]
                    }
                  },
                  "required": [
                    "nodeId",
                    "scope"
                  ],
                  "additionalProperties": false
                }
              },
              "unresolvedTargets": {
                "maxItems": 128,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "documentIdentifier": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "locator": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 8000
                    }
                  },
                  "required": [
                    "documentIdentifier",
                    "locator",
                    "reason"
                  ],
                  "additionalProperties": false
                }
              },
              "effectiveFrom": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "effectiveUntil": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "conditions": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8000
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "kind",
              "targets",
              "unresolvedTargets",
              "effectiveFrom",
              "effectiveUntil",
              "conditions"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "statement",
          "support",
          "effectId",
          "legalEffect"
        ],
        "additionalProperties": false
      }
    },
    "sourceUnits": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceNodeId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "disposition": {
            "type": "string",
            "enum": [
              "ANALYZED",
              "NO_REQUIREMENT",
              "BLOCKED"
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "sourceNodeId",
          "disposition",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "references": {
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "referenceId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "material": {
            "type": "boolean"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          },
          "fromCandidateId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "targetNodeId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "DEFINITION",
                  "SCOPE",
                  "QUALIFIER",
                  "EXCEPTION",
                  "CROSS_REFERENCE",
                  "CONDITION",
                  "INCORPORATES",
                  "TEMPORALLY_LIMITS",
                  "CONDITION_OF",
                  "QUALIFIES",
                  "EXCEPTION_TO",
                  "TEMPORALLY_APPLIES_TO",
                  "DEFINED_BY",
                  "PRESERVES",
                  "EVIDENCE_SLICE_OF",
                  "CONTEXT_FOR"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "referenceId",
          "material",
          "reason",
          "fromCandidateId",
          "targetNodeId",
          "kind"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "packageId",
    "candidates",
    "legalEffects",
    "sourceUnits",
    "references"
  ],
  "additionalProperties": false
}
