model {
  extend lcsp {
    clientGateway = webApp 'Single Client Entrypoint (HTTP Gateway)' {
      technology 'Browser / Web Client / External API Client'
      description 'Single entry point for all frontend & client API calls to LCSP.'
    }

    bffProxy = webApp 'Next.js BFF Proxy Layer' {
      technology 'apps/web/src/lib/server/upstream-request.ts'
      description 'Centralized Next.js Server Proxy performing session/cookie validation, URL normalization, and envelope forwarding.'
    }
  }

  extend lcsp.api {
    authWorkspaceController = controller 'AuthWorkspaceController' {
      technology 'apps/api/src/modules/auth-workspace/presentation/http/auth-workspace.controller.ts'
      description 'Handles /auth/sign-in, /auth/sessions, /auth/profile, and workspace onboarding.'
    }

    githubController = controller 'GitHubIntegrationController' {
      technology 'apps/api/src/modules/github-integration/presentation/http/github-integration.controller.ts'
      description 'Handles /github/app/start, /github/app/callback, and /assessments/:id/snapshots.'
    }

    wizardController = controller 'WizardController' {
      technology 'apps/api/src/modules/wizard/presentation/http/wizard.controller.ts'
      description 'Handles /assessments/:id/wizard/draft and /assessments/:id/wizard/submit.'
    }

    scanController = controller 'ScanController' {
      technology 'apps/api/src/modules/scan/presentation/http/scan.controller.ts'
      description 'Handles /assessments/:id/scan-jobs and /assessments/:id/scan-jobs/rerun.'
    }

    internalScanCallbackController = controller 'InternalScanController' {
      technology 'apps/api/src/modules/scan/presentation/http/internal-scan.controller.ts'
      description 'Internal webhook callback route /internal/scan-jobs/:scanJobId/callback from Python Scanner Worker.'
    }

    reconciliationController = controller 'ReconciliationController' {
      technology 'apps/api/src/modules/reconciliation/presentation/http/reconciliation.controller.ts'
      description 'Handles /assessments/:id/conflicts and /assessments/:id/conflicts/:id/resolve.'
    }

    internalReconciliationCallbackController = controller 'InternalReconciliationController' {
      technology 'apps/api/src/modules/reconciliation/presentation/http/internal-reconciliation.controller.ts'
      description 'Internal callback /internal/reconciliation/verified-profile-callback from Python Worker.'
    }

    documentController = controller 'DocumentController' {
      technology 'apps/api/src/modules/document/presentation/http/document.controller.ts'
      description 'Handles /assessments/:id/documents/final-report and download endpoints.'
    }

    internalDocumentCallbackController = controller 'InternalDocumentController' {
      technology 'apps/api/src/modules/document/presentation/http/internal-document.controller.ts'
      description 'Internal callback route /internal/document-requests/:id/callback from Python Document Worker.'
    }

    // CQRS Handlers
    githubCallbackHandler = handler 'GitHubAppCallbackHandler' {
      technology 'apps/api/src/modules/github-integration/application/commands/github-app-callback/github-app-callback.handler.ts'
      description 'Exchanges installation code, verifies repository scope, and stores RepositoryConnection.'
    }

    submitWizardHandler = handler 'SubmitWizardHandler' {
      technology 'apps/api/src/modules/wizard/application/commands/submit-wizard/submit-wizard.handler.ts'
      description 'Validates Wizard answers, calculates readiness status, and persists WizardProfile.'
    }

    createScanJobHandler = handler 'CreateScanJobHandler' {
      technology 'apps/api/src/modules/scan/application/commands/create-scan-job/create-scan-job.handler.ts'
      description 'Validates snapshot readiness, creates RepositoryScanJob, and writes OutboxMessage.'
    }

    resolveConflictHandler = handler 'ResolveConflictHandler' {
      technology 'apps/api/src/modules/reconciliation/application/commands/resolve-conflict/resolve-conflict.handler.ts'
      description 'Applies Manager conflict resolution choices and triggers VerifiedProfile creation.'
    }

    requestDocumentHandler = handler 'RequestDocumentHandler' {
      technology 'apps/api/src/modules/document/application/commands/request-document/request-document.handler.ts'
      description 'Verifies classification & citation guardrails, creates DocumentRequest, and publishes outbox event.'
    }

    // Domain Services
    pbacService = service 'PbacEvaluatorService' {
      technology 'apps/api/src/platform/pbac/pbac-evaluator.service.ts'
      description 'Evaluates SCREAMING_SNAKE_CASE actions against subject attributes & tenant policy scope.'
    }

    githubService = service 'GitHubAppService' {
      technology 'apps/api/src/modules/github-integration/infrastructure/github-app.service.ts'
      description 'Communicates with GitHub API, verifies App JWT & repository installation tokens.'
    }

    auditService = service 'AuditService' {
      technology 'apps/api/src/modules/audit/infrastructure/audit.service.ts'
      description 'Writes sanitized AuditEvent records without raw source or secrets.'
    }

    outboxPublisherService = service 'OutboxPublisherService' {
      technology 'apps/api/src/platform/outbox/outbox-publisher.service.ts'
      description 'Polls OutboxMessage table and publishes transactional domain events to RabbitMQ.'
    }

    // Repositories
    prismaDataMapper = repository 'Prisma Data Mapper / Repository Layer' {
      technology 'apps/api/src/platform/prisma/prisma.service.ts'
      description 'Maps domain aggregates to PostgreSQL tables via Prisma Client.'
    }
  }

  extend lcsp.queue {
    scanTriggersQueue = queueChannel 'Queue: lcsp.queue.scan.triggers' {
      description 'RabbitMQ queue delivering scan job triggers to Python Scanner Worker.'
    }

    reconciliationJobsQueue = queueChannel 'Queue: lcsp.queue.reconciliation.jobs' {
      description 'RabbitMQ queue delivering claim reconciliation tasks to Python Worker.'
    }

    documentGenerationQueue = queueChannel 'Queue: lcsp.queue.document.generation' {
      description 'RabbitMQ queue delivering report PDF rendering jobs to Python Document Worker.'
    }
  }

  // Developer Component Connections
  lcsp.clientGateway -> lcsp.bffProxy '1. HTTP Request (Single Entrypoint Gateway)'
  lcsp.bffProxy -> lcsp.api.githubController 'Proxy GET /github/app/callback'
  lcsp.bffProxy -> lcsp.api.scanController 'Proxy POST /assessments/:id/scan-jobs'
  lcsp.bffProxy -> lcsp.api.reconciliationController 'Proxy PATCH /assessments/:id/conflicts/:id/resolve'
  lcsp.bffProxy -> lcsp.api.documentController 'Proxy POST /assessments/:id/documents/final-report'

  lcsp.api.scanController -> lcsp.api.pbacService 'Check PBAC ACTION: ASSESSMENTS_SCAN_EXECUTE'
  lcsp.api.scanController -> lcsp.api.createScanJobHandler 'Execute Command: CreateScanJobCommand'

  lcsp.api.createScanJobHandler -> lcsp.api.githubService 'Validate commit-pinned snapshot digest'
  lcsp.api.createScanJobHandler -> lcsp.api.prismaDataMapper 'Persist RepositoryScanJob (QUEUED state)'
  lcsp.api.createScanJobHandler -> lcsp.api.auditService 'Log scan job creation audit event'
  lcsp.api.createScanJobHandler -> lcsp.api.prismaDataMapper 'Write OutboxMessage (REPOSITORY_SCAN_JOB)'

  lcsp.api.outboxPublisherService -> lcsp.api.prismaDataMapper 'Poll PENDING OutboxMessage records'
  lcsp.api.outboxPublisherService -> lcsp.queue.scanTriggersQueue 'Publish event to RabbitMQ Queue'

  lcsp.queue.scanTriggersQueue -> lcsp.pythonWorkers.scannerWorker 'Consume scan job message'
  githubApp -> lcsp.pythonWorkers.scannerWorker 'Fetch commit-pinned snapshot code'
  lcsp.pythonWorkers.scannerWorker -> lcsp.api.internalScanCallbackController 'HTTP POST /internal/scan-jobs/:id/callback'

  lcsp.api.internalScanCallbackController -> lcsp.api.prismaDataMapper 'Persist TechnicalEvidenceReport (ACCEPTED)'
  lcsp.api.internalScanCallbackController -> lcsp.queue.reconciliationJobsQueue 'Publish evidence collected event to RabbitMQ'

  lcsp.queue.reconciliationJobsQueue -> lcsp.pythonWorkers.reconciliationWorker 'Consume evidence reconciliation job'
  lcsp.pythonWorkers.reconciliationWorker -> lcsp.api.internalReconciliationCallbackController 'HTTP POST /internal/reconciliation/verified-profile-callback'
  lcsp.api.internalReconciliationCallbackController -> lcsp.api.prismaDataMapper 'Persist VerifiedProfile record'

  lcsp.api.reconciliationController -> lcsp.api.resolveConflictHandler 'Execute Command: ResolveConflictCommand'
  lcsp.api.resolveConflictHandler -> lcsp.api.prismaDataMapper 'Save Manager conflict resolution choice'

  lcsp.api.documentController -> lcsp.api.requestDocumentHandler 'Execute Command: RequestDocumentCommand'
  lcsp.api.requestDocumentHandler -> lcsp.api.pbacService 'Check PBAC ACTION: DOCUMENTS_GENERATE'
  lcsp.api.requestDocumentHandler -> lcsp.api.prismaDataMapper 'Persist DocumentRequest & OutboxMessage'
  lcsp.api.outboxPublisherService -> lcsp.queue.documentGenerationQueue 'Publish event: document.request.created'
  lcsp.queue.documentGenerationQueue -> lcsp.pythonWorkers.documentWorker 'Consume document render task'
  lcsp.pythonWorkers.documentWorker -> lcsp.objectStore 'Save generated compliance report PDF'
}

views {
  view dev_single_entrypoint_architecture of lcsp {
    title 'Developer Architecture - Single Entrypoint to Code Pipeline'
    description 'Comprehensive Developer view from Single Client Entrypoint -> Next BFF -> Controllers -> CQRS Handlers -> Services -> Repositories -> Outbox -> RabbitMQ -> Workers -> Storage.'
    include *
  }

  dynamic view dev_single_entrypoint_end_to_end_trace {
    title 'Developer E2E Code Execution Trace (URL -> Controller -> Handler -> Repo -> Service -> RabbitMQ)'
    description 'Detailed step-by-step execution trace from single client entrypoint through all backend layers, CQRS handlers, Prisma repositories, Outbox, RabbitMQ queues, and Python worker callbacks.'

    lcsp.clientGateway -> lcsp.bffProxy '1. HTTP Request from Client (Single Entrypoint Gateway)'
    lcsp.bffProxy -> lcsp.api.scanController '2. Next.js BFF Proxies POST /api/assessments/:id/scan-jobs'
    lcsp.api.scanController -> lcsp.api.pbacService '3. Controller invokes PbacEvaluatorService (check permissions)'
    lcsp.api.scanController -> lcsp.api.createScanJobHandler '4. Controller dispatches CreateScanJobCommand to CQRS Handler'
    lcsp.api.createScanJobHandler -> lcsp.api.githubService '5. Handler validates commit SHA via GitHubAppService'
    lcsp.api.createScanJobHandler -> lcsp.api.prismaDataMapper '6. Handler calls Prisma Service to insert RepositoryScanJob'
    lcsp.api.createScanJobHandler -> lcsp.api.prismaDataMapper '7. Handler writes OutboxMessage record inside DB transaction'
    lcsp.api.outboxPublisherService -> lcsp.api.prismaDataMapper '8. OutboxPollerService reads PENDING OutboxMessage'
    lcsp.api.outboxPublisherService -> lcsp.queue.scanTriggersQueue '9. OutboxPublisherService publishes event to RabbitMQ queue'
    lcsp.queue.scanTriggersQueue -> lcsp.pythonWorkers.scannerWorker '10. Python Scanner Worker consumes scan job from RabbitMQ'
    githubApp -> lcsp.pythonWorkers.scannerWorker '11. Scanner Worker fetches code from GitHub App snapshot'
    lcsp.pythonWorkers.scannerWorker -> lcsp.api.internalScanCallbackController '12. Worker posts results back to /internal/scan-jobs/:id/callback'
    lcsp.api.internalScanCallbackController -> lcsp.api.prismaDataMapper '13. Internal controller persists TechnicalEvidenceReport to PostgreSQL'
  }
}
