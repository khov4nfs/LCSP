model {
  extend lcsp.web {
    // ----------------------------------------------------
    // FRONTEND PAGES & COMPONENTS (apps/web/src)
    // ----------------------------------------------------
    signInPage = frontendPage 'Sign-in Page' {
      technology 'apps/web/src/app/(auth)/sign-in/page.tsx'
      description 'Next.js App Router Page rendering user login interface.'
    }

    signInForm = frontendComponent 'SignInForm Organism' {
      technology 'apps/web/src/features/auth/components/organisms/sign-in-form.tsx'
      description 'React Hook Form + Zod component handling credentials input & validation.'
    }

    settingsPage = frontendPage 'Settings Page' {
      technology 'apps/web/src/app/workspace/settings/page.tsx'
      description 'Workspace settings page for managing team, repositories, and credentials.'
    }

    repoConnectCard = frontendComponent 'GitHubRepositoryConnectCard Molecule' {
      technology 'apps/web/src/features/settings/components/molecules/github-repository-connect-card.tsx'
      description 'UI card triggering GitHub App OAuth connection & showing repo status.'
    }

    wizardPage = frontendPage 'Assessment Wizard Page' {
      technology 'apps/web/src/app/workspace/assessments/[id]/wizard/page.tsx'
      description 'Assessment questionnaire wizard page.'
    }

    wizardContainer = frontendComponent 'AssessmentWizardContainer Organism' {
      technology 'apps/web/src/features/wizard/components/organisms/assessment-wizard-container.tsx'
      description 'Multi-step form container collecting purpose, sector, data & AI declarations.'
    }

    reconciliationPage = frontendPage 'Conflict Resolution Page' {
      technology 'apps/web/src/app/workspace/assessments/[id]/reconciliation/page.tsx'
      description 'Page displaying material mismatches between declarations and evidence.'
    }

    conflictWorkspace = frontendComponent 'ConflictResolutionWorkspace Organism' {
      technology 'apps/web/src/features/reconciliation/components/organisms/conflict-resolution-workspace.tsx'
      description 'Interactive table for Manager to review evidence vs wizard conflicts & submit resolution.'
    }

    documentPage = frontendPage 'Document Center Page' {
      technology 'apps/web/src/app/workspace/assessments/[id]/documents/page.tsx'
      description 'Regulatory report generation & download management page.'
    }

    documentCenter = frontendComponent 'DocumentCenter Organism' {
      technology 'apps/web/src/features/document/components/organisms/document-center.tsx'
      description 'UI card triggering final report generation and serving PDF download links.'
    }

    // ----------------------------------------------------
    // FRONTEND HELPERS & BFF ROUTES (apps/web/src/app/api)
    // ----------------------------------------------------
    apiRequestHelper = service 'apiRequest Client Helper' {
      technology 'apps/web/src/lib/api/api-request.ts'
      description 'Client-side fetch wrapper handling envelope parsing and session credentials.'
    }

    upstreamRequestHelper = service 'upstreamRequest Server Helper' {
      technology 'apps/web/src/lib/server/upstream-request.ts'
      description 'Server-side BFF helper attaching bearer session cookies & forwarding requests to NestJS API.'
    }

    signInRoute = nextRoute 'BFF: POST /api/auth/sign-in' {
      technology 'apps/web/src/app/api/auth/sign-in/route.ts'
      description 'Next BFF proxy route handling login & session cookie establishment.'
    }

    githubStartRoute = nextRoute 'BFF: GET /api/github/app/start' {
      technology 'apps/web/src/app/api/github/app/start/route.ts'
      description 'BFF route initiating GitHub App authorization redirect.'
    }

    githubCallbackRoute = nextRoute 'BFF: GET /api/github/app/callback' {
      technology 'apps/web/src/app/api/github/app/callback/route.ts'
      description 'BFF route receiving GitHub installation callback & forwarding to NestJS API.'
    }

    wizardDraftRoute = nextRoute 'BFF: PUT /api/assessments/:id/wizard/draft' {
      technology 'apps/web/src/app/api/assessments/[id]/wizard/draft/route.ts'
      description 'BFF route forwarding wizard draft autosave payload.'
    }

    wizardSubmitRoute = nextRoute 'BFF: POST /api/assessments/:id/wizard/submit' {
      technology 'apps/web/src/app/api/assessments/[id]/wizard/submit/route.ts'
      description 'BFF route forwarding finalized wizard declarations submission.'
    }

    conflictResolveRoute = nextRoute 'BFF: PATCH /api/assessments/:id/conflicts/:id/resolve' {
      technology 'apps/web/src/app/api/assessments/[id]/conflicts/[conflictId]/resolve/route.ts'
      description 'BFF route forwarding Manager conflict resolution decision.'
    }

    docRequestRoute = nextRoute 'BFF: POST /api/assessments/:id/documents/final-report' {
      technology 'apps/web/src/app/api/assessments/[id]/documents/final-report/route.ts'
      description 'BFF route requesting regulatory compliance report generation.'
    }

    docDownloadRoute = nextRoute 'BFF: GET /api/assessments/:id/documents/:id/download' {
      technology 'apps/web/src/app/api/assessments/[id]/documents/[documentRequestId]/download/route.ts'
      description 'BFF route serving signed PDF document download stream.'
    }
  }
}

views {
  // ====================================================
  // FEATURE EXECUTION FLOW DYNAMIC VIEWS
  // ====================================================

  dynamic view flow_auth_signin {
    title 'Feature Flow 1: Authentication & Sign-in'
    description 'Complete end-to-end execution path from Sign-in Page to NestJS Auth Controller & Session Audit.'

    lcsp.web.signInPage -> lcsp.web.signInForm '1. User renders Sign-in Page & enters credentials'
    lcsp.web.signInForm -> lcsp.web.apiRequestHelper '2. Form calls apiRequest("/api/auth/sign-in", { body })'
    lcsp.web.apiRequestHelper -> lcsp.web.signInRoute '3. HTTP POST /api/auth/sign-in'
    lcsp.web.signInRoute -> lcsp.web.upstreamRequestHelper '4. BFF Route delegates to upstreamRequest helper'
    lcsp.web.upstreamRequestHelper -> lcsp.api.authWorkspaceController '5. Proxies request to NestJS AuthWorkspaceController'
    lcsp.api.authWorkspaceController -> lcsp.api.pbacService '6. Evaluates user authentication & tenant policy scope'
    lcsp.api.authWorkspaceController -> lcsp.api.prismaDataMapper '7. Verifies password hash & creates AuthRecord(type=SESSION) record in PostgreSQL'
    lcsp.api.authWorkspaceController -> lcsp.api.auditService '8. Writes AuditEvent (redacted metadata)'
    lcsp.api.authWorkspaceController -> lcsp.web.signInRoute '9. Returns success envelope { ok: true, data: session }'
    lcsp.web.signInRoute -> lcsp.web.signInForm '10. Sets HTTP-only session cookie & redirects to /workspace'
  }

  dynamic view flow_github_repository_scan {
    title 'Feature Flow 2: GitHub App Connect & Automatic Repository Scan'
    description 'Execution path from Settings Page repo connect card to Scanner Worker & evidence callback.'

    lcsp.web.settingsPage -> lcsp.web.repoConnectCard '1. Manager views GitHub Repository Connect Card'
    lcsp.web.repoConnectCard -> lcsp.web.githubStartRoute '2. Click Connect Repository (GET /api/github/app/start)'
    lcsp.web.githubStartRoute -> githubApp '3. Redirects to GitHub App authorization URL'
    githubApp -> lcsp.web.githubCallbackRoute '4. GitHub redirects back to GET /api/github/app/callback?code=...'
    lcsp.web.githubCallbackRoute -> lcsp.web.upstreamRequestHelper '5. BFF forwards callback to NestJS API'
    lcsp.web.upstreamRequestHelper -> lcsp.api.githubController '6. Proxies to GitHubIntegrationController.callback()'
    lcsp.api.githubController -> lcsp.api.githubCallbackHandler '7. Dispatches GitHubAppCallbackCommand to handler'
    lcsp.api.githubCallbackHandler -> lcsp.api.githubService '8. Exchanges code for installation token via GitHubAppService'
    lcsp.api.githubCallbackHandler -> lcsp.api.prismaDataMapper '9. Persists RepositoryConnection in PostgreSQL'
    lcsp.api.githubController -> lcsp.api.createScanJobHandler '10. Triggers automatic CreateScanJobCommand'
    lcsp.api.createScanJobHandler -> lcsp.api.prismaDataMapper '11. Writes RepositoryScanJob & OutboxMessage record'
    lcsp.api.outboxPublisherService -> lcsp.api.prismaDataMapper '12. OutboxPollerService reads PENDING OutboxMessage'
    lcsp.api.outboxPublisherService -> lcsp.queue.scanTriggersQueue '13. Publishes event to RabbitMQ queue lcsp.queue.scan.triggers'
    lcsp.queue.scanTriggersQueue -> lcsp.pythonWorkers.scannerWorker '14. Python Scanner Worker consumes scan job message'
    githubApp -> lcsp.pythonWorkers.scannerWorker '15. Scanner Worker fetches commit-pinned repository snapshot'
    lcsp.pythonWorkers.scannerWorker -> lcsp.api.internalScanCallbackController '16. Worker posts evidence to /internal/scan-jobs/:id/callback'
    lcsp.api.internalScanCallbackController -> lcsp.api.prismaDataMapper '17. Saves TechnicalEvidenceReport in PostgreSQL'
  }

  dynamic view flow_wizard_declarations {
    title 'Feature Flow 3: Assessment Wizard Profile Declarations'
    description 'Execution path from Assessment Wizard Page to NestJS Wizard Controller & Database Persistence.'

    lcsp.web.wizardPage -> lcsp.web.wizardContainer '1. Manager opens Wizard Page & fills declarations'
    lcsp.web.wizardContainer -> lcsp.web.apiRequestHelper '2. Form calls apiRequest("/api/assessments/:id/wizard/submit")'
    lcsp.web.wizardContainer -> lcsp.web.wizardSubmitRoute '3. HTTP POST /api/assessments/:id/wizard/submit'
    lcsp.web.wizardSubmitRoute -> lcsp.web.upstreamRequestHelper '4. BFF delegates to upstreamRequest helper'
    lcsp.web.upstreamRequestHelper -> lcsp.api.wizardController '5. Proxies request to NestJS WizardController'
    lcsp.api.wizardController -> lcsp.api.pbacService '6. Checks PBAC action: ASSESSMENTS_WIZARD_SUBMIT'
    lcsp.api.wizardController -> lcsp.api.submitWizardHandler '7. Dispatches SubmitWizardCommand to handler'
    lcsp.api.submitWizardHandler -> lcsp.api.prismaDataMapper '8. Persists WizardProfile answers & status in PostgreSQL'
    lcsp.api.submitWizardHandler -> lcsp.web.wizardSubmitRoute '9. Returns updated Assessment readiness status'
  }

  dynamic view flow_reconciliation_conflict {
    title 'Feature Flow 4: Evidence & Declaration Conflict Resolution'
    description 'Execution path from Conflict Workspace UI to Reconciliation Controller & VerifiedProfile approval.'

    lcsp.web.reconciliationPage -> lcsp.web.conflictWorkspace '1. Manager inspects evidence vs declaration mismatches'
    lcsp.web.conflictWorkspace -> lcsp.web.apiRequestHelper '2. Submits resolution decision for conflict item'
    lcsp.web.conflictWorkspace -> lcsp.web.conflictResolveRoute '3. PATCH /api/assessments/:id/conflicts/:id/resolve'
    lcsp.web.conflictResolveRoute -> lcsp.web.upstreamRequestHelper '4. BFF forwards request to NestJS API'
    lcsp.web.upstreamRequestHelper -> lcsp.api.reconciliationController '5. Proxies to ReconciliationController'
    lcsp.api.reconciliationController -> lcsp.api.resolveConflictHandler '6. Dispatches ResolveConflictCommand to handler'
    lcsp.api.resolveConflictHandler -> lcsp.api.prismaDataMapper '7. Updates ConflictRecord status to RESOLVED in PostgreSQL'
    lcsp.pythonWorkers.reconciliationWorker -> lcsp.api.internalReconciliationCallbackController '8. Reconciliation Worker verifies zero open conflicts remain'
    lcsp.api.internalReconciliationCallbackController -> lcsp.api.prismaDataMapper '9. Persists approved VerifiedProfile record (basis for legal RAG)'
  }

  dynamic view flow_legal_rag_classification {
    title 'Feature Flow 5: Official Legal Ingestion, ChromaDB Vectorless RAG & Classification'
    description 'Execution path from official legal source ingestion to ChromaDB retriever & LLM Risk Classification.'

    officialLegalPortals -> lcsp.pythonWorkers.legalIngestionWorker '1. Crawls official legal portals & law PDFs'
    lcsp.pythonWorkers.legalIngestionWorker -> lcsp.objectStore '2. Stores raw PDF/HTML snapshots in MinIO / S3'
    legalOperator -> lcsp.web.upstreamRequestHelper '3. Legal Operator approves LegalCorpusVersion via API'
    lcsp.api.outboxPublisherService -> lcsp.pythonWorkers.chromaIndexer '4. Triggers ChromaDB vectorless index build'
    lcsp.pythonWorkers.chromaIndexer -> lcsp.chromaDB '5. Indexes Clause/Article hierarchical chunks into ChromaDB'
    lcsp.pythonWorkers.legalMatchingWorker -> lcsp.pythonWorkers.chromaRetriever '6. Queries vectorless index by direct ID & 1-hop context expansion'
    lcsp.pythonWorkers.chromaRetriever -> lcsp.chromaDB '7. Retrieves citation-backed legal rule allowlist'
    lcsp.pythonWorkers.classificationWorker -> lcsp.pythonWorkers.llmGateway '8. Sends VerifiedProfile + citation allowlist to LLM Gateway'
    lcsp.pythonWorkers.llmGateway -> llmProviders '9. Invokes LLM provider with privacy & cost controls'
    lcsp.pythonWorkers.classificationWorker -> lcsp.api.prismaDataMapper '10. Saves ClassificationResult with legal citations in PostgreSQL'
  }

  dynamic view flow_document_generation_export {
    title 'Feature Flow 6: Regulatory Compliance Report Generation & Export'
    description 'Execution path from Document Center Page to Python Document Worker PDF rendering & S3 download stream.'

    lcsp.web.documentPage -> lcsp.web.documentCenter '1. Manager clicks Generate Final Compliance Report'
    lcsp.web.documentCenter -> lcsp.web.apiRequestHelper '2. Calls apiRequest("/api/assessments/:id/documents/final-report")'
    lcsp.web.documentCenter -> lcsp.web.docRequestRoute '3. POST /api/assessments/:id/documents/final-report'
    lcsp.web.docRequestRoute -> lcsp.web.upstreamRequestHelper '4. BFF forwards request to NestJS API'
    lcsp.web.upstreamRequestHelper -> lcsp.api.documentController '5. Proxies to DocumentController'
    lcsp.api.documentController -> lcsp.api.requestDocumentHandler '6. Dispatches RequestDocumentCommand (Citation Guardrail check)'
    lcsp.api.requestDocumentHandler -> lcsp.api.prismaDataMapper '7. Inserts DocumentRequest & OutboxMessage in PostgreSQL'
    lcsp.api.outboxPublisherService -> lcsp.queue.documentGenerationQueue '8. OutboxPollerService publishes event to RabbitMQ'
    lcsp.queue.documentGenerationQueue -> lcsp.pythonWorkers.documentWorker '9. Python Document Worker consumes document render task'
    lcsp.pythonWorkers.documentWorker -> lcsp.objectStore '10. Renders guarded PDF compliance report & uploads to S3'
    lcsp.pythonWorkers.documentWorker -> lcsp.api.internalDocumentCallbackController '11. Posts document ready callback with S3 URL'
    lcsp.api.internalDocumentCallbackController -> lcsp.api.prismaDataMapper '12. Updates DocumentRequest status to READY'
    lcsp.web.documentCenter -> lcsp.web.docDownloadRoute '13. Manager clicks Download Report PDF (GET /api/assessments/:id/documents/:id/download)'
    lcsp.web.docDownloadRoute -> lcsp.objectStore '14. BFF streams signed PDF report file from S3 to Manager browser'
  }
}
