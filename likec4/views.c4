views {
  view index {
    title 'LCSP System Landscape'
    description 'High-level overview of LCSP Platform, actors, external integrations, and shared assessment-memory architecture for multi-tenant orchestration.'
    include *
  }

  view containers of lcsp {
    title 'LCSP System Containers'
    description 'Containers inside LCSP: Web Frontend, NestJS API, Python Workers, Database, ChromaDB, Queue, Object Storage, and the assessment-memory services/read-models used by orchestration.'
    include *
  }

  view pythonWorkersView of lcsp.pythonWorkers {
    title 'Python Worker Platform Architecture'
    description 'Bounded asynchronous services for managed repository analysis, reconciliation, legal ingestion, ChromaDB vectorless RAG, and document generation.'
    include *
  }

  view evidenceScanFlow {
    title 'Repository Analysis to Verified Profile Flow'
    description 'Workflow from GitHub App repository trigger to Repository Analysis Agent evidence derivation and Reconciliation Worker VerifiedProfile.'
    include
      githubApp,
      lcsp.web,
      lcsp.api,
      lcsp.queue,
      lcsp.pythonWorkers.repositoryAnalysisWorker,
      lcsp.pythonWorkers.aiUsageWorker,
      lcsp.pythonWorkers.reconciliationWorker,
      lcsp.database
  }

  view legalRetrievalFlow {
    title 'Legal Ingestion & ChromaDB Vectorless RAG Flow'
    description 'Vectorless legal retrieval pipeline using ChromaDB, Clause/Article context expansion, and citation guardrails.'
    include
      officialLegalPortals,
      lcsp.pythonWorkers.legalIngestionWorker,
      lcsp.objectStore,
      lcsp.pythonWorkers.chromaIndexer,
      lcsp.chromaDB,
      lcsp.pythonWorkers.chromaRetriever,
      lcsp.pythonWorkers.legalMatchingWorker,
      lcsp.pythonWorkers.classificationWorker,
      lcsp.pythonWorkers.gapAnalysisWorker,
      lcsp.pythonWorkers.documentWorker
  }

  view assessmentMemoryEntry of lcsp {
    title 'Assessment Memory Entry View'
    description 'Entry-point view for assessment-scoped memory: identity context, orchestration checkpoints, pinned artifacts, tool execution logs, and prompt-safe projections.'
    include
      lcsp.web,
      lcsp.api.assessmentContextService,
      lcsp.api.orchestrationRuntime,
      lcsp.api.toolDispatchController,
      lcsp.api.artifactReadModel,
      lcsp.api.promptContextBuilder,
      lcsp.pythonWorkers.toolResolver,
      lcsp.pythonWorkers.llmGateway,
      lcsp.database.assessmentEntity,
      lcsp.database.wizardProfileEntity,
      lcsp.database.workflowRunEntity,
      lcsp.database.workflowCheckpointEntity,
      lcsp.database.missingInputStateEntity,
      lcsp.database.pinnedArtifactRefEntity,
      lcsp.database.toolExecutionLogEntity,
      lcsp.database.decisionLedgerEntity,
      lcsp.database.assessmentPromptViewEntity,
      lcsp.queue
  }
}
