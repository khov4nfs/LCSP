  "failure": {
    "alert": 82,
    "url": "https://github.com/khov4nfs/LCSP/security/code-scanning/82",
    "rule": {
      "id": "LC-019",
      "severity": "note",
      "description": "LangChain tool description is too short to guide model selection",
      "name": "",
      "tags": [
        "langchain",
        "python",
        "tool"
      ],
      "full_description": "A description under 40 characters is rarely enough to convey what a tool does, what it returns, and when to call it rather than a similarly named neighbor. LangChain passes this text to the model as the tool's only selection signal, so a stub like \"Gets data.\" leaves scope and preconditions to guesswork. In an AgentExecutor loop the cost compounds: each mis-selected call consumes an iteration against LC-102's max_iterations budget, so a run can exhaust its steps re-trying tools it picked badly and return nothing useful.\n",
      "help": "Expand the description to at least a full sentence covering inputs, outputs, and the situation in which this tool should be used over the alternatives.\n",
      "security_severity_level": "low"
    },
    "location": {
      "path": "deepagents/tests/test_live_preparation_usage.py",
      "start_line": 162,
      "end_line": 164,
      "start_column": 1,
      "end_column": 0
    },
    "state": null
  },
  "fix": "Expanded fixture tool description to state its integer input, string result and provider-free resampling purpose; no dismissal or policy change.",
  "focusedTest": {
    "name": "test_same_provider_resampling_keeps_usage_for_rejected_answer",
