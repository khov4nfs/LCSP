  "legalRequirements": [
    {
      "id": "badf724a-69ea-4fda-a152-cdb9a92c0d2e",
      "ruleSetVersionId": "5234415b-aed2-47a5-95cd-6254173aa164",
      "legalRequirementId": "LR-INPERSON",
      "title": "In-person attendance duty",
      "proposition": "The operator must appoint a person to attend the annual public information session in person. Attendance is recorded in the session register maintained by the organizer.",
      "applicabilityConditions": [
        "The operator offers the notice service to the public"
      ],
      "qualifiers": [
        "The session is annual",
        "Attendance is recorded in the session register maintained by the organizer"
      ],
      "exceptions": [],
      "nonRepositoryDuty": true,
      "coverageState": "NON_ASSESSABLE",
      "nonAssessableReason": "The duty requires appointing and ensuring in-person attendance at an external session maintained by an organizer. Repository or software evidence cannot establish the actual performance of in-person attendance; the session register is maintained by the external organizer, not the assessed system.",
      "contentDigest": "b95f7ec937fe927783a289816db901370ef1f27e4309aa4fc0938bdcd742b3a5",
      "ordinal": 1
    },
    {
      "id": "cdd82baf-c7b6-4228-ab44-a5f2478c06d3",
      "ruleSetVersionId": "5234415b-aed2-47a5-95cd-6254173aa164",
      "legalRequirementId": "LR-RETENTION",
      "title": "Record retention duty",
      "proposition": "An operator offering the notice service to the public must retain each record (stored notice and its receipt timestamp) for 7 days from the receipt timestamp, keeping the notice text with its receipt timestamp and preserving the notice text without removing its limiting language, except for temporary test records.",
      "applicabilityConditions": [
        "The operator offers the notice service to the public"
      ],
      "qualifiers": [
        "The receipt timestamp is recorded when the notice is received, not when it is drafted",
        "The retention period begins at the receipt timestamp"
      ],
      "exceptions": [
        "The retention duty does not apply to a temporary test record"
      ],
      "nonRepositoryDuty": false,
      "coverageState": "COVERED_BY_ASSESSMENT_RULES",
      "nonAssessableReason": null,
      "contentDigest": "c5d7317689165c8397ce47e8523cf26e0a418da5cec536bc1be35dc78b941342",
      "ordinal": 0
    }
  ],
