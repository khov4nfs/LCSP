  "legalRequirements": [
    {
      "id": "b6f34ed0-c979-4832-aa98-2e14fb917c89",
      "ruleSetVersionId": "40fc8b6e-0789-4cc4-a473-a6887d65ecfe",
      "legalRequirementId": "LR-1",
      "title": "Record retention duty for notice service operators",
      "proposition": "An operator offering the notice service to the public must retain each record (stored notice and its receipt timestamp) for 7 days from the receipt timestamp, keeping the notice text with its receipt timestamp and preserving the notice text without removing its limiting language.",
      "applicabilityConditions": [
        "The operator offers the notice service to the public (not private household use)"
      ],
      "qualifiers": [
        "The retention period of 7 days begins when the receipt timestamp is recorded, which occurs when the notice is received, not when it is drafted"
      ],
      "exceptions": [
        "The retention duty does not apply to a temporary test record"
      ],
      "nonRepositoryDuty": false,
      "coverageState": "COVERED_BY_ASSESSMENT_RULES",
      "nonAssessableReason": null,
      "contentDigest": "8988c8b40613992c9e0fd99bf975be21a4530c34b082dc0a08a491f62fc14bcc",
      "ordinal": 0
    },
    {
      "id": "6474b05e-9a36-4d92-8045-d521bf455a2c",
      "ruleSetVersionId": "40fc8b6e-0789-4cc4-a473-a6887d65ecfe",
      "legalRequirementId": "LR-2",
      "title": "In-person attendance duty at annual public information session",
      "proposition": "The operator must appoint a person to attend the annual public information session in person. Attendance is recorded in the session register maintained by the organizer.",
      "applicabilityConditions": [
        "The operator offers the notice service to the public (not private household use)"
      ],
      "qualifiers": [
        "Attendance must be in person",
        "Attendance is recorded in the session register maintained by the organizer"
      ],
      "exceptions": [],
      "nonRepositoryDuty": true,
      "coverageState": "NON_ASSESSABLE",
      "nonAssessableReason": "This duty requires appointing and sending a person to physically attend an in-person session. The action of appointing and the physical attendance cannot be established through repository or software evidence. The session register is maintained by an external organizer, not by the operator's software system.",
      "contentDigest": "9bbef07db882c56110635e111a12695f7b35e45adb4a873c8aa07dc34418efb2",
      "ordinal": 1
    }
  ],
  "assessmentRules": [
    {
      "id": "2de86503-c8e8-4b91-b377-70ac900ecda5",
      "ruleSetVersionId": "40fc8b6e-0789-4cc4-a473-a6887d65ecfe",
      "assessmentRuleId": "AR-1",
      "assessmentRuleVersion": "release-synthetic-f52606b690a84c87",
      "concept": "Notice record retention with timestamp and content integrity",
      "legalIntent": "Ensure that operators offering notice services to the public retain complete records (notice text with receipt timestamp) for 7 days from receipt, preserving the notice text without removing limiting language, except for temporary test records.",
      "applicabilityGuidance": "This rule applies to software systems operated by entities that offer a notice service to the public. Private household use is outside scope. The rule applies to each record (stored notice and its receipt timestamp) that is not a temporary test record. A record becomes subject to retention when the receipt timestamp is recorded at the time the notice is received, not when drafted.",
      "criteria": [
        {
          "statement": "Each non-test record must be retained for at least 7 days from its receipt timestamp.",
          "criterionId": "C-1"
        },
        {
          "statement": "Each retained record must include both the notice text and its receipt timestamp stored together.",
          "criterionId": "C-2"
        },
        {
          "statement": "The notice text must be preserved without removing its limiting language throughout the retention period.",
          "criterionId": "C-3"
        }
      ],
      "contract": {
        "concept": "Notice record retention with timestamp and content integrity",
