      "legalRuleId": "LR-ART-6-IN-PERSON",
      "title": "In-person annual information session attendance duty",
      "proposition": "The operator must appoint a person to attend the annual public information session in person, with attendance recorded in the session register maintained by the organizer.",
      "applicabilityConditions": [
        "Applies to operators subject to the instrument."
      ],
      "qualifiers": [
        "Annual public information session attendance."
