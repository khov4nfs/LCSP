      "legalRuleId": "LR-ART-5-RETENTION",
      "title": "Record retention duty for notice service operators",
      "proposition": "An operator offering the notice service to the public must retain each record (defined as a stored notice and its receipt timestamp) for 7 days, subject to Article 3, keeping the notice text with its receipt timestamp (which begins the retention period when the notice is received, not when it is drafted) and preserving the notice text without removing its limiting language.",
      "applicabilityConditions": [
        "Applies only to operators offering the notice service to the public. Private household use is outside scope. Temporary test records are excepted under Article 3."
      ],
      "qualifiers": [
        "Retention period is 7 days beginning at the receipt timestamp."
      ],
      "exceptions": [
        "The retention duty does not apply to a temporary test record under Article 3."
      ],
      "nonRepositoryDuty": false,
      "coverageState": "COVERED_BY_ENGINEERING_RULES",
