      "legalRuleId": "LR-RETENTION-DUTY",
      "title": "Retention Duty for Public Notice Records",
      "proposition": "An operator within Article 2 must retain each record for 7 days, subject to Article 3. Keep the notice text with its receipt timestamp. Preserve the notice text without removing its limiting language. The receipt timestamp begins the retention period and is recorded when the notice is received, not when it is drafted.",
      "applicabilityConditions": [
        "Applies to operators offering the notice service to the public. Private household use is excluded."
      ],
      "qualifiers": [
        "Must retain for 7 days beginning at receipt timestamp."
      ],
      "exceptions": [
        "Does not apply to a temporary test record under Article 3."
      ],
      "nonRepositoryDuty": false,
