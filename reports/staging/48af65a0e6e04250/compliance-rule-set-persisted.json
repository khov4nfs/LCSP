  "legalRequirements": [
    {
      "id": "a0fb901f-4a93-4eed-8668-9d3298aec0ee",
      "ruleSetVersionId": "505bc936-1590-447e-b505-68ab283868c6",
      "legalRequirementId": "LR-1",
      "title": "Record Retention Duty",
      "proposition": "An operator within Article 2 must retain each record for 7 days from receipt, keeping the notice text with its receipt timestamp and preserving the notice text without removing its limiting language, subject to the exception for temporary test records.",
      "applicabilityConditions": [
        "The operator offers the notice service to the public (not private household use)."
      ],
      "qualifiers": [
        "The 7-day retention period begins when the receipt timestamp is recorded, which occurs when the notice is received, not when it is drafted."
      ],
      "exceptions": [
        "The retention duty does not apply to a temporary test record."
      ],
      "nonRepositoryDuty": false,
      "coverageState": "COVERED_BY_ASSESSMENT_RULES",
      "nonAssessableReason": null,
      "contentDigest": "e6308c51c6e2c5b8505c66ed0c273e5143a01a46546f943cb00c178716a18221",
      "ordinal": 0
    },
    {
      "id": "1da1dd88-1d09-48cc-954b-25ee3237aecb",
      "ruleSetVersionId": "505bc936-1590-447e-b505-68ab283868c6",
      "legalRequirementId": "LR-2",
      "title": "In-Person Attendance Duty",
      "proposition": "The operator must appoint a person to attend the annual public information session in person. Attendance is recorded in the session register maintained by the organizer.",
      "applicabilityConditions": [],
      "qualifiers": [
        "Attendance must be in person.",
        "The annual public information session is the event requiring attendance."
      ],
      "exceptions": [],
      "nonRepositoryDuty": true,
      "coverageState": "NON_ASSESSABLE",
      "nonAssessableReason": "This duty requires appointing and ensuring a person physically attends an external annual session. Attendance is recorded in a register maintained by the session organizer, not by the operator's repository. Repository evidence cannot establish the performance of this organizational and in-person action.",
      "contentDigest": "7cdbae8a0405c49c72ac297975281cacfc1e619a88da22b35c20588efb470314",
      "ordinal": 1
    }
