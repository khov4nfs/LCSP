  "assessmentRules": [
    {
      "id": "4a2f0816-99ab-4c94-a4ca-858925aaf0b2",
      "ruleSetVersionId": "505bc936-1590-447e-b505-68ab283868c6",
      "assessmentRuleId": "AR-1",
      "assessmentRuleVersion": "release-synthetic-48af65a0e6e04250",
      "concept": "Notice Record Retention with Timestamp and Content Integrity",
      "legalIntent": "Ensure that operators offering a notice service to the public retain each notice record (the stored notice and its receipt timestamp) for 7 days from receipt, preserving both the notice text with its timestamp association and the integrity of the notice text without removing limiting language. Temporary test records are exempt from this retention requirement.",
      "applicabilityGuidance": "This rule applies to operators offering the notice service to the public. It does not apply to private household use. The retention duty applies to each record (a stored notice and its receipt timestamp as defined in Article 1). The duty does not apply to temporary test records.",
      "criteria": [
        {
          "statement": "Each non-test notice record must be retained for at least 7 days, measured from the receipt timestamp. The receipt timestamp is recorded when the notice is received, not when it is drafted.",
          "criterionId": "C-1"
        },
        {
          "statement": "Each retained record must include both the notice text and its associated receipt timestamp together.",
          "criterionId": "C-2"
        },
        {
          "statement": "The notice text must be preserved without removing its limiting language; the stored content must maintain the original limiting language present in the notice.",
          "criterionId": "C-3"
        }
      ],
      "contract": {
