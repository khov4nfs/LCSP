      "portfolioVersionId": "78261f5b-bb2e-4316-a171-bc3315ac2aa3",
      "legalRuleId": "LR-RETENTION",
      "title": "Retention of notice records for 7 days",
      "proposition": "An operator offering the notice service to the public must retain each record (stored notice and its receipt timestamp) for 7 days from the receipt timestamp, keeping the notice text with its receipt timestamp and preserving the notice text without removing its limiting language, except for temporary test records.",
      "applicabilityConditions": [
        "Operator offering the notice service to the public (Article 2)",
        "Record is not a temporary test record (exception per Article 3)"
      ],
      "qualifiers": [
        "Retention period of 7 days begins at the receipt timestamp, which is recorded when the notice is received, not when it is drafted (Article 4)",
        "Each record must be retained individually"
      ],
      "exceptions": [
        "The retention duty does not apply to a temporary test record (Article 3)"
      ],
      "nonRepositoryDuty": false,
      "coverageState": "COVERED_BY_ASSESSMENT_RULES",
