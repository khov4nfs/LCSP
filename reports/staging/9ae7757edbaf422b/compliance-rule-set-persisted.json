      "legalRuleId": "LR-INPERSON",
      "title": "Appointment for annual public information session attendance",
      "proposition": "The operator offering the notice service to the public must appoint a person to attend the annual public information session in person.",
      "applicabilityConditions": [
        "Operator offering the notice service to the public (Article 2)"
      ],
      "qualifiers": [
        "Attendance is in person",
        "Session is annual",
        "Attendance is recorded in the session register maintained by the organizer"
      ],
      "exceptions": [],
      "nonRepositoryDuty": true,
      "coverageState": "NON_ASSESSABLE",
      "nonAssessableReason": "The duty requires appointing a person and in-person attendance at a physical session. Repository or software evidence cannot establish that the operator appointed a person or that physical attendance occurred. The session register is maintained by an external organizer, not the assessed operator's repository.",
      "contentDigest": "f66df495474311ce2dc2e95e728f7b4ad00ab9f635f014e40360b7cd601fbc1e",
      "ordinal": 1
    },
    {
