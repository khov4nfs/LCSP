      "idempotencyKey": "decision:ca52b86a-6514-4c92-91e8-708678673f51:53f33094475f1e38dee20d8b",
      "requestDigest": "ffe58b9bc3811bf33eff9a722f51e3b55d7681d02aa7c769da1205a3e945161d",
      "decision": {
        "scopeId": "ASSESSMENT",
        "criteria": [
          {
            "outcome": "NOT_MET",
            "rationale": "The delete_expired method calculates retention expiry from draft_timestamp instead of receipt_timestamp. Line 43 uses 'notice.draft_timestamp + RETENTION_PERIOD <= now' to identify expired records, violating the requirement that retention period begins at the receipt timestamp (Article 4, clause 1(a)). The 7-day period must start from when the notice is received, not drafted.",
            "references": [
              {
                "type": "ASSESSMENT_EVIDENCE",
                "evidenceId": "45df9d12-3e35-5c12-9652-5be33eb8c6c3"
              },
              {
                "type": "ASSESSMENT_EVIDENCE",
                "evidenceId": "32b54a49-3c5b-5cc0-a635-515f2d32f702"
              }
            ],
            "criterionId": "C-1"
          },
          {
            "outcome": "MET",
            "rationale": "The Notice dataclass includes both notice_text (line 12) and receipt_timestamp (line 13) fields. The database schema (schema.sql lines 3-4) defines both notice_text and receipt_timestamp as NOT NULL columns, ensuring both components are stored together for each record.",
            "references": [
              {
                "type": "ASSESSMENT_EVIDENCE",
                "evidenceId": "f13d4c00-c074-55e2-8c75-bd64f4e62a47"
              },
              {
                "type": "ASSESSMENT_EVIDENCE",
                "evidenceId": "9aadb0c5-d3b5-54ed-afe3-90e3b5bfd626"
              }
            ],
            "criterionId": "C-2"
          },
          {
            "outcome": "MET",
            "rationale": "The notice_text field is stored without modification. The receive method (lines 22-33) stores the notice_text parameter directly in the Notice dataclass (line 30) without any transformation, stripping, or filtering. No code in the repository modifies or removes content from stored notice text. The frozen dataclass ensures immutability after creation. Repository-wide search found no text manipulation operations (strip, replace, or limiting language removal).",
            "references": [
              {
                "type": "ASSESSMENT_EVIDENCE",
                "evidenceId": "4c4ba90e-dfe9-50e0-9e45-a01530266ddc"
              },
              {
                "type": "ASSESSMENT_EVIDENCE",
                "evidenceId": "f13d4c00-c074-55e2-8c75-bd64f4e62a47"
              }
            ],
            "criterionId": "C-3"
          },
          {
            "outcome": "MET",
            "rationale": "The receive method accepts receipt_timestamp as a parameter (line 24) separate from draft_timestamp (line 25), and stores it directly in the Notice record (line 30). The method signature and implementation correctly distinguish between when a notice was drafted versus when it was received, allowing the caller to provide the receipt timestamp at the time of receipt.",
            "references": [
              {
                "type": "ASSESSMENT_EVIDENCE",
                "evidenceId": "4c4ba90e-dfe9-50e0-9e45-a01530266ddc"
              }
            ],
            "criterionId": "C-4"
          }
        ],
        "rationale": "The rule is applicable because the customer confirmed that this notice service is operated by an entity offering the service to the public and is publicly reachable, meeting the scope condition in Article 2. The system handles notice records with receipt timestamps as defined in Article 1. The temporary test record exception (Article 3) is properly scoped within the criteria.",
        "compliance": "NON_COMPLIANT",
        "references": [
          {
            "type": "ASSESSMENT_EVIDENCE",
            "evidenceId": "991ecdd0-9689-55df-b3d0-021f2b4d20ef"
          },
