      "legalRuleId": "LR-INPERSON",
      "title": "In-person attendance at annual session",
      "proposition": "The operator must appoint a person to attend the annual public information session in person. Attendance is recorded in the session register maintained by the organizer.",
      "applicabilityConditions": [
        "Operator offers the notice service to the public (not private household use)"
      ],
      "qualifiers": [],
      "exceptions": [],
      "nonRepositoryDuty": true,
      "coverageState": "NON_ASSESSABLE",
      "nonAssessableReason": "This duty requires appointing a person and in-person physical attendance at an external event. The attendance record is maintained by an external organizer, not by the operator's software system. Repository evidence cannot establish performance of this organizational and physical duty.",
      "contentDigest": "b448f3010a150d4af55118862ed2f87e589f8617007dd270bbe88df866f6aa72",
      "ordinal": 1
    },
    {
      "id": "0e357475-062b-4744-9f5d-0da2cae7c69f",
      "portfolioVersionId": "1531de0b-29c1-4e82-8781-58c4e16f16a1",
      "legalRuleId": "LR-RETENTION",
      "title": "Retention of notice records",
      "proposition": "An operator within scope must retain each record (stored notice and receipt timestamp) for 7 days from receipt, keeping the notice text with its receipt timestamp and preserving the notice text without removing its limiting language.",
      "applicabilityConditions": [
        "Operator offers the notice service to the public (not private household use)"
      ],
      "qualifiers": [
        "The receipt timestamp begins the retention period",
        "A receipt timestamp is recorded when the notice is received, not when it is drafted"
      ],
      "exceptions": [
        "The retention duty does not apply to a temporary test record"
      ],
      "nonRepositoryDuty": false,
