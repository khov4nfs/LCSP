      "engineeringRuleId": "AR-RETENTION",
      "engineeringRuleVersion": "release-synthetic-9ae7757edbaf422b-supersession",
      "concept": "Notice record retention with timestamp and content integrity",
      "legalIntent": "Ensure operators retain complete notice records (text and receipt timestamp) for the mandated 7-day period beginning at receipt, while preserving the integrity of the notice text including any limiting language it contains.",
      "applicabilityGuidance": "This rule applies to software systems operated by entities offering a notice service to the public. It does not apply to private household use. The retention obligation applies to each record (defined as a stored notice and its receipt timestamp) except temporary test records.",
      "criteria": [
        {
          "statement": "Each notice record must be retained for at least 7 days from the receipt timestamp.",
          "criterionId": "C-1"
        },
        {
          "statement": "The notice text must be stored together with its receipt timestamp.",
          "criterionId": "C-2"
        },
        {
          "statement": "The receipt timestamp must be recorded when the notice is received, not when it is drafted.",
          "criterionId": "C-3"
        },
        {
          "statement": "The notice text must be preserved without removing its limiting language.",
          "criterionId": "C-4"
        }
      ],
