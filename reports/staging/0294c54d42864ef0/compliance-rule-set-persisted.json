  "legalRequirements": [
    {
      "id": "1d90192a-1ddd-4687-b4c3-8bc7c594aacf",
      "ruleSetVersionId": "533c7e7b-3a93-482e-82d3-0642c9bf5488",
      "legalRequirementId": "LR-IN-PERSON-ATTENDANCE",
      "title": "In-person attendance duty",
      "proposition": "The operator must appoint a person to attend the annual public information session in person. Attendance is recorded in the session register maintained by the organizer.",
      "applicabilityConditions": [
        "The operator offers the notice service to the public (not private household use)"
      ],
      "qualifiers": [
        "Attendance is recorded in the session register maintained by the organizer"
      ],
      "exceptions": [],
      "nonRepositoryDuty": true,
      "coverageState": "NON_ASSESSABLE",
      "nonAssessableReason": "This duty requires organizational action (appointing a person) and in-person physical attendance at an external event. Repository or software evidence cannot establish performance of the physical attendance itself. Attendance is recorded in an external register maintained by the organizer, not by the assessed operator's software system.",
      "contentDigest": "67e7ec89c7ce5d828274d5a8679f687120945956c3e6b42c519f12e38e15a0e7",
      "ordinal": 1
    },
    {
      "id": "b2457d85-8285-43cf-b406-3286887ae57e",
      "ruleSetVersionId": "533c7e7b-3a93-482e-82d3-0642c9bf5488",
      "legalRequirementId": "LR-RETENTION",
      "title": "Record retention duty",
      "proposition": "An operator offering the notice service to the public must retain each record (stored notice and its receipt timestamp) for 7 days from the receipt timestamp, keeping the notice text with its receipt timestamp and preserving the notice text without removing its limiting language, except for temporary test records.",
      "applicabilityConditions": [
        "The operator offers the notice service to the public (not private household use)"
      ],
      "qualifiers": [
        "The receipt timestamp begins the retention period",
        "A receipt timestamp is recorded when the notice is received, not when it is drafted"
      ],
      "exceptions": [
        "The retention duty does not apply to a temporary test record"
      ],
      "nonRepositoryDuty": false,
      "coverageState": "COVERED_BY_ASSESSMENT_RULES",
      "nonAssessableReason": null,
      "contentDigest": "326913d482ea03e304cbf14c79a3103fa92f2d12b9e5f1a01b8e9c9c0c4162c6",
      "ordinal": 0
    }
  ],
  "assessmentRules": [
    {
      "id": "f0a3ef3c-b373-4799-8a22-268275c87ced",
      "ruleSetVersionId": "533c7e7b-3a93-482e-82d3-0642c9bf5488",
      "assessmentRuleId": "ER-RETENTION",
      "assessmentRuleVersion": "release-synthetic-0294c54d42864ef0",
      "concept": "Record retention with content and timestamp preservation",
      "legalIntent": "Ensure operators offering notice services to the public retain complete records (notice text and receipt timestamp) for 7 days from receipt, preserving notice content integrity including any limiting language, except for temporary test records.",
      "applicabilityGuidance": "This rule applies to software systems operated by entities offering a notice service to the public. Private household use is outside scope. The system must handle records as defined: a stored notice and its receipt timestamp. Investigate whether the system captures and retains these records. The exception for temporary test records means the retention duty does not apply to those records; investigate whether the system distinguishes test records and applies different retention treatment.",
      "criteria": [
        {
          "statement": "Records must be retained for 7 days from the receipt timestamp. The retention period begins at the receipt timestamp, which is recorded when the notice is received, not when it is drafted.",
          "criterionId": "C-1"
        },
        {
          "statement": "Each record must include both the notice text and its receipt timestamp stored together.",
          "criterionId": "C-2"
        },
        {
          "statement": "The notice text must be preserved without removing its limiting language throughout the retention period.",
          "criterionId": "C-3"
        }
      ],
      "contract": {
        "concept": "Record retention with content and timestamp preservation",
        "criteria": [
          {
            "statement": "Records must be retained for 7 days from the receipt timestamp. The retention period begins at the receipt timestamp, which is recorded when the notice is received, not when it is drafted.",
            "criterionId": "C-1"
          },
          {
