        "negativeEvidence": [
          "Retention period shorter than 7 days from receipt timestamp",
          "Receipt timestamp recorded at draft time rather than receipt time",
          "Notice text stored separately from receipt timestamp without linkage",
          "Evidence of notice text modification or removal of content during retention period",
          "Temporary test records subject to the same 7-day retention as production records"
        ],
        "requiredEvidence": [
          "Data retention policy or configuration specifying retention period for records",
          "Storage schema showing how notice text and receipt timestamp are persisted together",
          "Implementation of receipt timestamp capture at the point of notice receipt",
          "Mechanism for preserving notice text content without modification or removal of limiting language"
        ],
        "startingNodeTypes": [],
        "investigationGoals": [
          "Identify how records (notice text and receipt timestamp) are stored in the system",
          "Determine the retention period applied to records and when that period begins",
          "Verify that the receipt timestamp is captured at notice receipt, not at draft time",
          "Confirm that notice text and receipt timestamp are kept together as a record",
          "Check whether notice text integrity is maintained, specifically whether any limiting language is preserved or could be removed",
          "Identify whether temporary test records exist and whether different retention rules apply to them"
        ],
        "supportingEvidence": [
          "Retention enforcement mechanism (e.g., deletion job, archive process) that respects the 7-day period from receipt timestamp",
