          "idempotencyKey": "decision:bd19ac62-d59c-41e8-97eb-64aaf2d7ea65:5a34b77694d41efe81b37bc6",
          "requestDigest": "57c5264e67288dfc950a2352843566a0096069d4623eb459346f54f07a4d0760",
          "decision": {
            "scopeId": "ASSESSMENT",
            "criteria": [
              {
                "outcome": "NOT_MET",
                "rationale": "The retention period is set to 7 days (RETENTION_PERIOD = timedelta(days=7)), but the delete_expired method incorrectly uses draft_timestamp instead of receipt_timestamp to calculate when records expire. Line 44 calculates 'notice.draft_timestamp + RETENTION_PERIOD <= now', meaning the retention period begins at draft time rather than receipt time. The legal requirement explicitly states the retention period must begin at the receipt timestamp, and the qualifier confirms 'A receipt timestamp is recorded when the notice is received, not when it is drafted.'",
                "references": [
                  {
                    "type": "ASSESSMENT_EVIDENCE",
                    "evidenceId": "eacdde4d-7542-5881-b017-480a68526e7d"
                  },
                  {
                    "type": "ASSESSMENT_EVIDENCE",
                    "evidenceId": "804d6ce0-2213-54b1-94c2-131ce6c53e7d"
                  }
                ],
                "criterionId": "C-1"
              },
              {
                "outcome": "MET",
                "rationale": "The Notice dataclass stores notice_text and receipt_timestamp as fields of the same object (lines 12-13), and the database schema defines both columns in the same table (schema.sql lines 3-4). The receive method captures both values together when creating a Notice instance (line 30), and they are stored together in the notices dictionary. The records maintain the linkage between text and timestamp throughout their lifecycle.",
                "references": [
                  {
                    "type": "ASSESSMENT_EVIDENCE",
                    "evidenceId": "4f1d0b53-6815-5bdb-9007-a80d1007ea72"
                  },
                  {
                    "type": "ASSESSMENT_EVIDENCE",
                    "evidenceId": "bc8c1db3-2f5e-504e-b7be-5ede8be74591"
                  },
                  {
                    "type": "ASSESSMENT_EVIDENCE",
                    "evidenceId": "b37d99e6-236b-556f-8372-df56c52ad466"
                  }
                ],
                "criterionId": "C-2"
              },
              {
                "outcome": "MET",
                "rationale": "The Notice dataclass is declared with frozen=True (line 9), making all instances immutable after creation. Once notice_text is stored in a Notice instance, it cannot be modified - Python's frozen dataclass mechanism prevents any field assignment. This immutability ensures that notice text, including any limiting language, is preserved without modification throughout the retention period.",
                "references": [
                  {
                    "type": "ASSESSMENT_EVIDENCE",
                    "evidenceId": "4f1d0b53-6815-5bdb-9007-a80d1007ea72"
                  }
                ],
                "criterionId": "C-3"
              }
            ],
            "rationale": "The rule applies because the operator offers this notice service to the public as an organization, as confirmed by the customer. The system handles records consisting of stored notices and receipt timestamps, which fall within the rule's scope. The exception for temporary test records is implemented (the system distinguishes test records via the is_temporary_test flag), but this exception removes the retention duty for those records only; it does not affect applicability of the rule overall.",
            "compliance": "NON_COMPLIANT",
            "references": [
              {
                "type": "ASSESSMENT_EVIDENCE",
                "evidenceId": "d6ac03ed-0531-52db-ae50-bbfa23a2debc"
              },
              {
                "type": "CONFIRMED_FACT",
                "factId": "52ba2ad9-3700-405e-8295-4940441df114",
                "caseRevision": 2
              },
              {
                "type": "ASSESSMENT_EVIDENCE",
                "evidenceId": "4f1d0b53-6815-5bdb-9007-a80d1007ea72"
              }
            ],
