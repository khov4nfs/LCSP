    {
      "id": "cf35932e-1394-4a34-9be3-58e5f3c70606",
      "ruleSetVersionId": "0f0ef8c8-6cbb-491c-9b7d-14c281bd5983",
      "legalRequirementId": "LR-IN-PERSON-ATTENDANCE",
      "title": "Appoint person to attend annual public information session in person",
      "proposition": "The operator must appoint a person to attend the annual public information session in person. Attendance is recorded in the session register maintained by the organizer.",
      "applicabilityConditions": [
        "The operator offers the notice service to the public"
      ],
      "qualifiers": [
        "Attendance must be in person",
        "Attendance is recorded in the session register maintained by the organizer"
      ],
      "exceptions": [],
      "nonRepositoryDuty": true,
      "coverageState": "NON_ASSESSABLE",
      "nonAssessableReason": "The duty requires appointing a person to attend an external in-person event. The action is human attendance at an event organized and recorded by an external organizer. Repository or software evidence cannot establish whether the operator appointed someone or whether that person attended in person.",
      "contentDigest": "35755e106df764b5873c2da6ab9e3d125531c6aea5bbdf19893729905fa993d5",
      "ordinal": 1
    },
    {
      "id": "420b9eef-40bb-455a-8214-7029dc839419",
      "ruleSetVersionId": "0f0ef8c8-6cbb-491c-9b7d-14c281bd5983",
      "legalRequirementId": "LR-RETENTION",
      "title": "Retention of notice records for 7 days",
      "proposition": "An operator offering the notice service to the public must retain each record (stored notice and its receipt timestamp) for 7 days beginning at receipt, keeping the notice text with its receipt timestamp and preserving the notice text without removing its limiting language, except for temporary test records.",
      "applicabilityConditions": [
        "The operator offers the notice service to the public (not private household use)"
      ],
      "qualifiers": [
        "The 7-day retention period begins when the receipt timestamp is recorded, which occurs when the notice is received, not when it is drafted",
        "A 'record' means a stored notice and its receipt timestamp"
      ],
      "exceptions": [
        "Temporary test records are exempt from this retention duty"
      ],
      "nonRepositoryDuty": false,
      "coverageState": "COVERED_BY_ASSESSMENT_RULES",
      "nonAssessableReason": null,
      "contentDigest": "1a235c2cb31d189ffbbb90f485ab7adb7a24bca37a2d76fa32fb8bd30a4491a3",
      "ordinal": 0
    }
  ],
  "assessmentRules": [
    {
      "id": "2d841f78-befd-41e9-a815-bfb79a5aaebb",
