      "assessmentRuleId": "ER-RETENTION",
      "assessmentRuleVersion": "release-synthetic-0294c54d42864ef0-supersession",
      "concept": "Notice record retention with timestamp and content integrity",
      "legalIntent": "Ensure operators retain notice records (stored notice and receipt timestamp) for 7 days from receipt, maintaining the association between notice text and timestamp, and preserving the original notice text without removing limiting language, except for temporary test records.",
      "applicabilityGuidance": "This rule applies to software systems operated by entities offering the notice service to the public. It does not apply to private household use. The rule applies to all records except temporary test records. A record consists of a stored notice and its receipt timestamp. The retention period begins when the notice is received (receipt timestamp recorded), not when the notice is drafted.",
      "criteria": [
        {
          "statement": "Each non-test record must be retained for at least 7 days from its receipt timestamp.",
          "criterionId": "C-1"
        },
        {
          "statement": "The notice text must be kept together with its receipt timestamp throughout the retention period.",
          "criterionId": "C-2"
        },
        {
          "statement": "The notice text must be preserved without removing its limiting language.",
          "criterionId": "C-3"
        }
      ],
      "contract": {
        "concept": "Notice record retention with timestamp and content integrity",
