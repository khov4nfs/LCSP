{
  "name": "lcsp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev:fogewise": "node scripts/run.mjs fogewise",
    "dev:fogewise:reset": "node scripts/run.mjs fogewise_reset",
    "dev:stop": "node scripts/run.mjs dev_stop",
    "prepare:cli": "node scripts/prepare-cli.mjs",
    "dev": "node scripts/dev-entry.mjs",
    "dev:local": "node scripts/dev-entry.mjs local",
    "dev:app": "node scripts/dev-entry.mjs app",
    "dev:docker": "node scripts/dev-entry.mjs docker",
    "dev:agent:docker": "node scripts/run.mjs agent_runtime_docker",
    "dev:agent:docker:build": "node scripts/run.mjs docker_worker_build",
    "dev:trace": "LCSP_DEV_UNSAFE_TRACE=true ORCHESTRATION_DEBUG=true LOG_LEVEL=DEBUG NODE_ENV=development pnpm run prepare:cli && pnpm --filter @lcsp/api prisma:migrate:deploy && LCSP_DEV_UNSAFE_TRACE=true ORCHESTRATION_DEBUG=true LOG_LEVEL=DEBUG NODE_ENV=development node scripts/run.mjs dev",
    "check:imports": "node scripts/check-import-policy.mjs",
    "check:contracts": "node scripts/check-contract-literals.mjs",
    "check:agentic-tools": "node scripts/check-agentic-tool-runtime.mjs",
    "test:dev-scripts": "node --test scripts/run-agent-runtime.test.mjs scripts/run-phoenix-config.test.mjs scripts/dev-stop.test.mjs scripts/cleanup-legacy-mda-rabbitmq.test.mjs",
    "eval:jev-decisions": "cd deepagents && uv run python -m decision.eval --dataset decision/eval_fixtures/lcsp_decision_eval_v1.json --output ../artifacts/decision/jev-decision-eval-report.json",
    "check:branch": "node scripts/check-branch-name.mjs",
    "check:commit-message": "node scripts/check-commit-message.mjs",
    "build:runtime-packages": "pnpm --filter @lcsp/contracts build && pnpm --filter @lcsp/i18n build",
    "likec4:build": "likec4 build likec4 -o dist/likec4",
    "likec4:check": "likec4 check likec4",
    "likec4:dev": "likec4 dev likec4 --open false",
    "likec4:export": "likec4 export png likec4 -o dist/likec4-export",
    "lint": "pnpm run check:imports && pnpm run check:contracts && pnpm run check:agentic-tools && pnpm run typecheck",
    "prepare": "husky",
    "test": "node scripts/with-check-memory.mjs pnpm run test:run",
    "test:run": "pnpm run test:web:run && pnpm --filter @lcsp/api test:e2e",
    "test:web": "node scripts/with-check-memory.mjs pnpm run test:web:run",
    "test:web:run": "pnpm run build:runtime-packages && pnpm exec tsx --tsconfig apps/web/tsconfig.test.json --test --test-concurrency=1 tests/*.web.test.ts && pnpm --dir apps/web exec tsx --tsconfig tsconfig.test.json --test --test-concurrency=1 'tests/*.test.ts'",
    "pretest:admin:e2e": "pnpm run build:runtime-packages",
    "test:admin:e2e": "playwright test tests/e2e/admin",
    "pretest:billing:e2e": "pnpm run build:runtime-packages",
    "test:billing:e2e": "playwright test tests/e2e/admin tests/e2e/billing",
    "check:billing-release-gate": "node scripts/check-billing-release-gate.mjs",
    "prisma:generate": "pnpm --filter @lcsp/api prisma:generate",
    "typecheck": "node scripts/with-check-memory.mjs pnpm run typecheck:run",
    "typecheck:run": "pnpm run prisma:generate && pnpm exec tsc -b",
    "seed:legal-corpus:dev:dry": "node scripts/seed-legal-dev.mjs corpus --dry-run",
    "seed:legal-corpus:dev": "node scripts/seed-legal-dev.mjs corpus",
    "seed:legal:dev": "node scripts/seed-legal-dev.mjs all",
    "delete:assessment": "node scripts/delete-assessment.mjs",
    "cleanup:legacy-mda-rabbitmq": "node scripts/cleanup-legacy-mda-rabbitmq.mjs"
  },
  "devDependencies": {
    "@lcsp/contracts": "workspace:*",
    "@lcsp/i18n": "workspace:*",
    "@lcsp/web": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@tanstack/ai": "^0.14.0",
    "@types/node": "^22.15.30",
    "dotenv": "16.6.1",
    "dotenv-expand": "12.0.3",
    "husky": "^9.1.7",
    "likec4": "^1.49.0",
    "prettier": "^3.9.4",
    "tsx": "^4.23.1",
    "typescript": "^5.8.0"
  }
}
