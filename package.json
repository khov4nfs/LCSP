{
  "name": "lcsp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev:fogewise": "node scripts/run.mjs fogewise",
    "dev:fogewise:reset": "node scripts/run.mjs fogewise_reset",
    "dev:stop": "node scripts/run.mjs dev_stop",
    "prepare:ts-js-analyzer": "node scripts/prepare-ts-js-analyzer.mjs",
    "dev": "pnpm --filter @lcsp/api prisma:migrate:deploy && pnpm run prepare:ts-js-analyzer && node scripts/run.mjs dev",
    "dev:app": "pnpm --filter @lcsp/api prisma:migrate:deploy && node scripts/run.mjs dev_app",
    "dev:docker": "pnpm --filter @lcsp/api prisma:migrate:deploy && node scripts/run.mjs dev_docker",
    "dev:agent:docker": "node scripts/run.mjs managed_agent_docker",
    "dev:agent:docker:build": "node scripts/run.mjs docker_worker_build",
    "dev:trace": "LCSP_DEV_UNSAFE_TRACE=true ORCHESTRATION_DEBUG=true LOG_LEVEL=DEBUG NODE_ENV=development pnpm --filter @lcsp/api prisma:migrate:deploy && pnpm run prepare:ts-js-analyzer && LCSP_DEV_UNSAFE_TRACE=true ORCHESTRATION_DEBUG=true LOG_LEVEL=DEBUG NODE_ENV=development node scripts/run.mjs dev",
    "check:imports": "node scripts/check-import-policy.mjs",
    "check:contracts": "node scripts/check-contract-literals.mjs",
    "check:agentic-tools": "node scripts/check-agentic-tool-runtime.mjs",
    "check:branch": "node scripts/check-branch-name.mjs",
    "check:commit-message": "node scripts/check-commit-message.mjs",
    "build:runtime-packages": "pnpm --filter @lcsp/contracts build && pnpm --filter @lcsp/i18n build",
    "likec4:build": "likec4 build likec4 -o dist/likec4",
    "likec4:check": "likec4 check likec4",
    "likec4:dev": "likec4 dev likec4 --open false",
    "likec4:export": "likec4 export png likec4 -o dist/likec4-export",
    "lint": "pnpm run check:imports && pnpm run check:contracts && pnpm run check:agentic-tools && pnpm run typecheck",
    "prepare": "husky",
    "test": "pnpm run test:web && pnpm --filter @lcsp/api test:e2e",
    "pretest:web": "pnpm run build:runtime-packages",
    "test:web": "node --experimental-strip-types --test tests/*.web.test.ts apps/web/tests/*.test.ts",
    "prisma:generate": "pnpm --filter @lcsp/api prisma:generate",
    "typecheck": "pnpm run prisma:generate && pnpm exec tsc -b",
    "seed:legal-corpus:dev:dry": "node scripts/seed-legal-dev.mjs corpus --dry-run",
    "seed:legal-corpus:dev": "node scripts/seed-legal-dev.mjs corpus",
    "seed:legal:dev": "node scripts/seed-legal-dev.mjs all",
    "delete:assessment": "node scripts/delete-assessment.mjs"
  },
  "devDependencies": {
    "@lcsp/contracts": "workspace:*",
    "@lcsp/i18n": "workspace:*",
    "@lcsp/web": "workspace:*",
    "@prisma/compute-sdk": "^0.33.0",
    "@tanstack/ai": "^0.14.0",
    "@types/node": "^22.15.30",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "dotenv": "16.6.1",
    "dotenv-expand": "12.0.3",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "likec4": "^1.49.0",
    "prettier": "^3.9.4",
    "tsx": "^4.23.1",
    "typescript": "^5.8.0"
  }
}
