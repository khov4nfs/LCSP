# LCSP environment template: secrets and deployment addresses only.
# Copy to .env and fill in. Never commit real values.
# Model selection lives in deepagents/config/model_routes.yaml (not here).

NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/lcsp?schema=public

# 64 hex characters (openssl rand -hex 32)
MFA_SECRET_ENCRYPTION_KEY=
# Google OAuth
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_ALLOWED_REDIRECT_ORIGINS=http://localhost:3000

RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672
# At least 32 chars, shared by API and worker
WORKER_API_KEY=

# Web/BFF -> API
LCSP_API_BASE_URL=http://127.0.0.1:3001
# Python worker -> API
NESTJS_API_BASE_URL=http://127.0.0.1:3001

# Provider credentials for the active routes
LLM7_API_KEY=
GEMINI_API_KEY=
APX_API_KEY=

# Envelope encryption of per-user repository credentials.
# KEYRING: JSON map of version -> 32-byte base64 key (openssl rand -base64 32); must contain the active version.
GITHUB_CLI_CREDENTIAL_KEK_ACTIVE_VERSION=kek-v1
GITHUB_CLI_CREDENTIAL_KEK_KEYRING={"kek-v1":"<base64-32-bytes>"}

# Email (optional)
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SePay payments (required in production)
BILLING_SEPAY_BANK_NAME=
BILLING_SEPAY_BANK_ACCOUNT_NUMBER=
BILLING_SEPAY_ACCOUNT_HOLDER=
BILLING_SEPAY_QR_URL_TEMPLATE=https://qr.example/img?amount={amountVnd}&content={paymentCode}
SEPAY_WEBHOOK_SECRET=

# ADMIN_SEED_PASSWORD: inject only when running the admin seed script; do not keep in .env.

# Optional overrides (defaults exist in code):
# OUTBOX_POLL_INTERVAL_MS=1000
# LLM_PROVIDER_TIMEOUT_SECONDS=
# LANGGRAPH_CHECKPOINT_DATABASE_URL=   # falls back to DATABASE_URL
# GITHUB_CLI_EXECUTABLE_PATH= / GITLAB_CLI_EXECUTABLE_PATH= / BITBUCKET_CLI_EXECUTABLE_PATH= / AZURE_DEVOPS_CLI_EXECUTABLE_PATH=
# LCSP_ARTIFACT_STORAGE_PATH= / LCSP_GRAPH_STORAGE_PATH= / LCSP_SNAPSHOT_ARCHIVE_CACHE_DIR=
# PHOENIX_*
# ORCHESTRATION_DEBUG=true   # opt-in verbose orchestration logging (dev:trace sets it)
