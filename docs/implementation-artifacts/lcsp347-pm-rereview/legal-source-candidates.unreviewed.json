          "legalStatus": "UNKNOWN",
          "legalEffectStatus": "EFFECTIVE",
          "sourceText": "Điều 12. Hồ sơ phân loại rủi ro của hệ thống trí tuệ nhân tạo",
          "sourceSha256": "3fa059d5229f5dc1fbbb867970ad7dcf344866625625c6197f0147fb378eb8bc",
          "hashVerified": true,
          "effectMetadataAvailable": true
        },
        {
          "id": "ea43540c-513e-4b76-969a-8415f06696f2::nghi-dinh-so-142-2026-nd-cp-quy-dinh-chi-tiet-thi-hanh-luat::art-12::cl-1",
          "documentId": "nghi-dinh-so-142-2026-nd-cp-quy-dinh-chi-tiet-thi-hanh-luat",
          "locator": "art-12::cl-1",
          "contentSha256": "sha256:01a25527cf77f068199b8d4f9a93c2dc7b4e9da8537398549c11ba9832b7c11c",
          "legalStatus": "UNKNOWN",
          "legalEffectStatus": "EFFECTIVE",
          "sourceText": "1. Nhà cung cấp phải lập hồ sơ phân loại rủi ro đối với hệ thống trí tuệ nhân tạo có rủi ro cao và hệ thống trí tuệ nhân tạo có rủi ro trung bình trước khi đưa hệ thống vào sử dụng theo quy định tại khoản 1 Điều 10 của Luật Trí tuệ nhân tạo.",
          "sourceSha256": "01a25527cf77f068199b8d4f9a93c2dc7b4e9da8537398549c11ba9832b7c11c",
          "hashVerified": true,
          "effectMetadataAvailable": true
        },
        {
          "id": "ea43540c-513e-4b76-969a-8415f06696f2::nghi-dinh-so-142-2026-nd-cp-quy-dinh-chi-tiet-thi-hanh-luat::art-12::cl-2",
          "documentId": "nghi-dinh-so-142-2026-nd-cp-quy-dinh-chi-tiet-thi-hanh-luat",
