          "contentSha256": "sha256:6f5c4ce5a665f44f15f99940e3a6a3a511507862884909a918bf3e093845f479",
          "legalStatus": "UNKNOWN",
          "legalEffectStatus": "EFFECTIVE",
          "sourceText": "2. Đối với hệ thống trí tuệ nhân tạo có rủi ro cao và rủi ro trung bình, nhà cung cấp phải bảo đảm hồ sơ phân loại rủi ro bao gồm các tài liệu sau đây:",
          "sourceSha256": "6f5c4ce5a665f44f15f99940e3a6a3a511507862884909a918bf3e093845f479",
          "hashVerified": true,
          "effectMetadataAvailable": true
        }
