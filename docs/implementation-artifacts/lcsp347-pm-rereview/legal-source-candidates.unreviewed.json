      "sourceTextCandidates": [
        {
          "id": "ea43540c-513e-4b76-969a-8415f06696f2::luat-so-116-2025-qh15-luat-an-ninh-mang::art-10::cl-2::pt-d",
          "documentId": "luat-so-116-2025-qh15-luat-an-ninh-mang",
          "locator": "art-10::cl-2::pt-d",
          "contentSha256": "sha256:d4ea75a7e8d66bc4973fd521d0bce4a9eae7c106ccae13f1e58a86842f0e2600",
          "legalStatus": "UNKNOWN",
          "legalEffectStatus": "EFFECTIVE",
          "sourceText": "d) Áp dụng biện pháp quản lý theo tiêu chuẩn, quy chuẩn kỹ thuật về an ninh mạng, nghiên cứu xây dựng hệ thống tường lửa quốc gia để phòng, chống nguy cơ, khắc phục sự cố an ninh mạng;",
          "sourceSha256": "d4ea75a7e8d66bc4973fd521d0bce4a9eae7c106ccae13f1e58a86842f0e2600",
          "hashVerified": true,
          "effectMetadataAvailable": true
        },
        {
          "id": "ea43540c-513e-4b76-969a-8415f06696f2::luat-so-116-2025-qh15-luat-an-ninh-mang::art-10::cl-2::pt-e",
          "documentId": "luat-so-116-2025-qh15-luat-an-ninh-mang",
