      "warning": "Lexical retrieval candidates only; neither applicability nor a legal disposition has been established",
      "sourceTextCandidates": [
        {
          "id": "ea43540c-513e-4b76-969a-8415f06696f2::luat-so-134-2025-qh15-luat-tri-tue-nhan-tao::art-12::cl-3",
          "documentId": "luat-so-134-2025-qh15-luat-tri-tue-nhan-tao",
