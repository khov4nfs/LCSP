          "legalStatus": "UNKNOWN",
          "legalEffectStatus": "EFFECTIVE",
          "sourceText": "Điều 10. Công cụ hỗ trợ phân loại rủi ro tự động",
          "sourceSha256": "1fa44492303a462649ae880bab4a52b43b19e7975de37ac37293bf22b6391467",
          "hashVerified": true,
          "effectMetadataAvailable": true
